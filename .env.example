# KOBA environment placeholders — copy to `.env.local` and fill in real values.
# Never commit secrets.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KOBA

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://koba:koba@localhost:5432/koba?schema=public

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-cryptographically-random-secret
AUTH_URL=http://localhost:3000

# Email (Resend). In production both are required or verification/reset fail closed.
# Locally, unset keys log links to the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=KOBA <onboarding@resend.dev>

# Rate limiting — leave unset for in-memory (single instance). Use Upstash for multi-instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe Connect (test mode). Placeholders fail closed — checkout will not fake paid.
# Live sk_live_ keys are rejected until an explicit live-mode rollout.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_CLIENT_ID=ca_replace_me
STRIPE_ALLOW_LIVE=false
# KOBA Plus recurring subscription price (created once in the Stripe
# Dashboard as a recurring $4.99/month Price, then its ID pasted here).
# Same fail-closed convention — Plus checkout is blocked until this is a
# real price_... id, same as Stripe Connect above.
STRIPE_PLUS_PRICE_ID=price_replace_me
# Platform fee in basis points. Cap 2500.
# Unverified / pending shops (default 800 = 8%). Verified Blue-Badge shops (default 400 = 4%).
KOBA_COMMISSION_BPS=800
KOBA_COMMISSION_BPS_VERIFIED=400
# Escrow: days the platform holds a seller's payout on its own Stripe balance
# before auto-release. Cap 30. A buyer dispute freezes the release timer.
KOBA_ESCROW_HOLD_DAYS=3

# Aiden generation providers (Vest/Graft/Terra). Vest/Graft now really call
# Replicate (SDXL/Kandinsky image gen) and Tripo (3D gen) depending on the
# asset type being generated — set REPLICATE_API_TOKEN / TRIPO_API_KEY to
# real credentials to enable them, same fail-closed convention as Stripe
# above. Terra (map/terrain) has no vendor decision yet (ROADMAP.md
# Phase 14, open question 1) — AIDEN_TERRA_PROVIDER_API_KEY stays a
# placeholder until one is chosen.
REPLICATE_API_TOKEN=replace_me
TRIPO_API_KEY=replace_me
AIDEN_TERRA_PROVIDER_API_KEY=replace_me

# Claude API — real, working integration (not a stub like the three above)
# for AI-assisted product descriptions. Same fail-closed convention.
ANTHROPIC_API_KEY=replace_me

# Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, etc.)
# Required for POST /api/media/presign. Social/DM media URLs must be https;
# when S3_PUBLIC_BASE_URL or MEDIA_ALLOWED_HOSTS is set, hosts are allowlisted.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=koba-media
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_PUBLIC_BASE_URL=
MEDIA_ALLOWED_HOSTS=

# Optional realtime service (deferred; Socket.IO or managed pub/sub)
REALTIME_URL=
