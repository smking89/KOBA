# KOBA environment placeholders — copy to `.env.local` and fill in real values.
# Never commit secrets.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KOBA

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://koba:koba@localhost:5432/koba?schema=public

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-cryptographically-random-secret
AUTH_URL=http://localhost:3000

# Email (Resend). In production both are required or verification/reset fail closed.
# Locally, unset keys log links to the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=KOBA <onboarding@resend.dev>

# Rate limiting — leave unset for in-memory (single instance). Use Upstash for multi-instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe Connect (test mode). Placeholders fail closed — checkout will not fake paid.
# Live sk_live_ keys are rejected until an explicit live-mode rollout.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_CLIENT_ID=ca_replace_me
STRIPE_ALLOW_LIVE=false
# Platform fee in basis points. Cap 2500.
# Unverified / pending shops (default 800 = 8%). Verified Blue-Badge shops (default 400 = 4%).
KOBA_COMMISSION_BPS=800
KOBA_COMMISSION_BPS_VERIFIED=400

# Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, etc.)
# Required for POST /api/media/presign. Social/DM media URLs must be https;
# when S3_PUBLIC_BASE_URL or MEDIA_ALLOWED_HOSTS is set, hosts are allowlisted.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=koba-media
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_PUBLIC_BASE_URL=
MEDIA_ALLOWED_HOSTS=

# Optional realtime service (deferred; Socket.IO or managed pub/sub)
REALTIME_URL=

# Server integration credential encryption (AES-256-GCM).
# Generate: openssl rand -base64 32
# Required before saving RCON credentials. Never commit a real key.
KOBA_CREDENTIAL_ENCRYPTION_KEY=
KOBA_CREDENTIAL_KEY_VERSION=1
# Optional previous versions for rotation: KOBA_CREDENTIAL_ENCRYPTION_KEY_V1=

# KOBA Plus (Stripe Billing test mode). Server maps plan codes to these Price IDs.
# Never send Price IDs or amounts from the browser. Live mode is not enabled.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PLUS_CURRENCY=usd
STRIPE_PLUS_MONTHLY_AMOUNT_CENTS=799
STRIPE_PLUS_ANNUAL_AMOUNT_CENTS=7188
# Trials stay off unless the owner explicitly enables them.
KOBA_PLUS_TRIALS_ENABLED=false

# Aiden (Phase 14G). Mock provider is the default. Do not enable paid vendor
# calls until a real adapter is reviewed. Never commit real API keys.
AIDEN_PROVIDER=mock
AIDEN_MODEL=aiden-mock-concept
AIDEN_MODEL_VERSION=1
AIDEN_PROVIDER_API_KEY=
AIDEN_PROVIDER_WEBHOOK_SECRET=
# Integer KOBA Coin prices. UI must read these via /api/aiden/estimate.
AIDEN_PRICE_CONCEPT_IMAGE=40
AIDEN_PRICE_CONCEPT_IMAGE_HD_SURCHARGE=20
AIDEN_PRICE_LARGE_SURCHARGE=15
AIDEN_ALLOW_COST_OVERRUN=false
# Optional extra prompt terms, comma-separated.
AIDEN_PROMPT_BLOCKLIST=
# Malware scan hook. Unset = not active. Do not claim scanning is enabled.
AIDEN_MALWARE_SCAN_URL=
# Worker: pnpm aiden:worker
# Queue is PostgreSQL (AidenJob.version claims). Redis is not used for jobs.
AIDEN_WORKER_LOOP=false
AIDEN_WORKER_INTERVAL_MS=5000

# Developer portal / app marketplace (Phase 14H)
# Commission in basis points. Falls back to KOBA_COMMISSION_BPS when unset.
KOBA_DEV_COMMISSION_BPS=800
KOBA_DEV_COMMISSION_BPS_VERIFIED=400
# Optional malware-scan hook. Unset = not active. Do not claim scanning is enabled.
DEV_MALWARE_SCAN_URL=
# Webhook worker: pnpm developers:webhooks
# Queue is PostgreSQL (DeveloperWebhookDelivery.version claims).
DEVELOPER_WEBHOOK_WORKER_LOOP=false
DEVELOPER_WEBHOOK_WORKER_INTERVAL_MS=5000
# Webhook signing secrets use KOBA_CREDENTIAL_ENCRYPTION_KEY (same as RCON).

# Influencer promo (Phase 14I)
# Max referral cut in basis points of order total (default 2500 = 25%), still capped by seller payout.
KOBA_INFLUENCER_MAX_BPS=2500
# Retry accrued/payable Stripe transfers: pnpm influencer:payouts
INFLUENCER_PAYOUT_WORKER_LOOP=false
INFLUENCER_PAYOUT_WORKER_INTERVAL_MS=15000

# Influencer campaigns / promo codes / sponsored ads (Phase 14I)
# Attribution window in hours (default 168 = 7 days). Campaigns may override.
KOBA_ATTRIBUTION_WINDOW_HOURS=168
# Integer basis-point caps. Never use floating point for money.
KOBA_MAX_COMMISSION_BPS=2500
KOBA_MAX_DISCOUNT_BPS=5000
# Refund hold before a commission can become AVAILABLE.
KOBA_COMMISSION_HOLD_HOURS=72
# Cost-per-click default in KOBA Coins (integer).
KOBA_AD_CPC_DEFAULT=5
# Fraud thresholds (counts / windows). Tune rather than hardcoding in code.
KOBA_REFERRAL_CLICK_BURST=20
KOBA_PROMO_GUESS_LIMIT=10
KOBA_CLICK_BURST_WINDOW_MS=60000
KOBA_AD_DUPLICATE_WINDOW_MS=30000
# Visitor HMAC retention. Raw IPs are not stored on promotion tables.
KOBA_CLICK_HASH_RETENTION_HOURS=48
# Worker: pnpm promotions:worker
PROMOTIONS_WORKER_LOOP=false
PROMOTIONS_WORKER_INTERVAL_MS=15000

# Staff MFA (Phase 15C). Required for privileged staff access.
# Generate: openssl rand -base64 32
# Never reuse KOBA_CREDENTIAL_ENCRYPTION_KEY. TOTP depends on reliable VPS time sync (NTP).
KOBA_STAFF_MFA_ENCRYPTION_KEY=
KOBA_STAFF_MFA_KEY_VERSION=1
# Optional previous versions for rotation: KOBA_STAFF_MFA_ENCRYPTION_KEY_V1=
# Immediate enforcement (default). Set false only for a documented emergency.
STAFF_MFA_ENFORCE=true
# Recent-MFA window for refunds, staff KOBAID issuance, MFA reset, etc. (minutes)
STAFF_STEPUP_WINDOW_MINUTES=15
# Privileged AAL2 session idle / absolute lifetime (shorter than the public JWT)
STAFF_SESSION_IDLE_MINUTES=60
STAFF_SESSION_ABSOLUTE_HOURS=12

# Observability (Phase 15D). Leave unset for local/dev — the app builds and runs without Sentry.
# Never commit real DSNs or auth tokens. Tests never send events (Sentry is forced off).
KOBA_SERVICE_NAME=koba
KOBA_LOG_LEVEL=info
# Set true to force JSON logs outside production.
KOBA_LOG_JSON=false
SENTRY_ENABLED=false
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# CI/VPS only. Used to upload source maps. Never expose to the browser.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# 0–1. Default 0 (no performance traces until explicitly enabled).
SENTRY_TRACES_SAMPLE_RATE=0
# Session replay stays disabled in code regardless of this placeholder.
NEXT_PUBLIC_SENTRY_ENABLED=false

# Optional worker loops (default one-shot / cron). See docs/operations/observability.md
SERVER_POLL_WORKER_LOOP=false
RUST_INTEGRATION_WORKER_LOOP=false
PLUS_RECONCILE_WORKER_LOOP=false

