// Major, independently-toggleable platform functions. This is the registry
// key set for the superadmin "kill switch" panel — see
// features/platform-control/lib/functions.ts for the human-readable
// registry (label/description) that maps onto these keys, and
// docs/tdls.md for why this exists (TDLS trust-boundary enforcement,
// slice 1 of 3: superadmin function control).
enum PlatformFunctionKey {
  STRIPE_PAYMENTS
  AIDEN_GENERATION
  CLAUDE_DESCRIPTION_ASSIST
  SOCIAL_POSTING
  MESSAGING
  TRADE
  MARKETPLACE_CHECKOUT
  SERVER_RCON
  PLUS_SUBSCRIPTIONS
}

