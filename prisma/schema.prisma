enum PromotionRateType {
  FIXED
  PERCENTAGE
}

enum AttributionSource {
  CLICK
  PROMO_CODE
}

enum PromotionCommissionStatus {
  PENDING
  QUALIFIED
  AVAILABLE
  REVERSED
  PAID
  CANCELLED
  UNDER_REVIEW
}

enum SponsoredEntityType {
  PRODUCT
  SHOP
  DEV_PRODUCT
  GAME_SERVER
}

enum SponsoredPlacement {
  MARKETPLACE
  SHOP
  APPS
  SERVERS
}

enum SponsoredCampaignStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
  SUSPENDED
  CANCELLED
}

enum SponsoredEventType {
  IMPRESSION
  CLICK
  SPEND
  RELEASE
}

model InfluencerProfile {
  id                   String                       @id @default(cuid())
  userId               String                       @unique
  slug                 String                       @unique
  displayName          String
  bio                  String                       @default("") @db.Text
  avatarUrl            String?
  bannerUrl            String?
  socialLinksJson      String                       @default("[]")
  games                String[]
  categories           String[]
  audienceRegions      String[]
  contactEmail         String?
  verificationStatus   InfluencerVerificationStatus @default(UNVERIFIED)
  verificationNote     String?
  suspendedAt          DateTime?
  payoutEligible       Boolean                      @default(false)
  disclosureAcceptedAt DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
}

model AffiliateCampaign {
  id                      String                  @id @default(cuid())
  publicRef               String                  @unique
  shopId                  String
  sellerUserId            String
  name                    String
  status                  AffiliateCampaignStatus @default(DRAFT)
  commissionType          PromotionRateType       @default(PERCENTAGE)
  commissionValue         Int                     @default(1000)
  discountType            PromotionRateType?
  discountValue           Int?
  attributionWindowHours  Int                     @default(168)
  totalBudgetCents        Int                     @default(0)
  remainingBudgetCents    Int                     @default(0)
  perInfluencerLimitCents Int?
  totalConversionLimit    Int?
  conversionCount         Int                     @default(0)
  targetGames             String[]
  targetCategories        String[]
  openApplications        Boolean                 @default(true)
  terms                   String                  @default("") @db.Text
  startsAt                DateTime?
  endsAt                  DateTime?
  moderationNote          String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  shop           Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  seller         User                       @relation("CampaignSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  products       AffiliateCampaignProduct[]
  participations CampaignParticipation[]
  promoCodes     PromoCode[]
  commissions    PromotionCommission[]
  orders         Order[]
  clickEvents    ReferralClickEvent[]

  @@index([shopId, status])
  @@index([sellerUserId, status])
}

model AffiliateCampaignProduct {
  campaignId String
  productId  String

  campaign AffiliateCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@index([productId])
}

model CampaignParticipation {
  id               String                      @id @default(cuid())
  publicRef        String                      @unique
  campaignId       String
  influencerUserId String
  status           CampaignParticipationStatus @default(APPLIED)
  referralToken    String                      @unique
  promoCodeId      String?
  termsAcceptedAt  DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  campaign    AffiliateCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer  User                  @relation(fields: [influencerUserId], references: [id], onDelete: Cascade)
  promoCode   PromoCode?            @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  clickEvents ReferralClickEvent[]
  commissions PromotionCommission[]
  orders      Order[]

  @@unique([campaignId, influencerUserId])
  @@index([influencerUserId, status])
  @@index([referralToken])
}

model PromoCode {
  id                     String            @id @default(cuid())
  code                   String            @unique
  sellerUserId           String
  shopId                 String
  campaignId             String?
  discountType           PromotionRateType
  discountValue          Int
  minOrderCents          Int               @default(0)
  maxDiscountCents       Int?
  usageLimit             Int?
  usageCount             Int               @default(0)
  perAccountLimit        Int               @default(1)
  startsAt               DateTime?
  endsAt                 DateTime?
  active                 Boolean           @default(true)
  applicableAccountTypes String[]
  stackingAllowed        Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  seller         User                    @relation("PromoCodeSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  shop           Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaign       AffiliateCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  products       PromoCodeProduct[]
  redemptions    PromoCodeRedemption[]
  participations CampaignParticipation[]
  orders         Order[]

  @@index([shopId, active])
  @@index([campaignId])
}

model PromoCodeProduct {
  promoCodeId String
  productId   String

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, productId])
  @@index([productId])
}

model PromoCodeRedemption {
  id          String   @id @default(cuid())
  promoCodeId String
  userId      String
  orderId     String?  @unique
  createdAt   DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([promoCodeId, userId])
}

model ReferralClickEvent {
  id              String   @id @default(cuid())
  publicRef       String   @unique
  participationId String
  campaignId      String
  visitorHash     String?
  destinationPath String
  idempotencyKey  String   @unique
  suspicious      Boolean  @default(false)
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  participation CampaignParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  campaign      AffiliateCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([participationId, createdAt])
  @@index([expiresAt])
}

model PromotionCommission {
  id                String                    @id @default(cuid())
  publicRef         String                    @unique
  campaignId        String
  participationId   String
  influencerUserId  String
  sellerUserId      String
  orderId           String                    @unique
  amountCents       Int
  currency          String                    @default("USD")
  status            PromotionCommissionStatus @default(PENDING)
  attributionSource AttributionSource
  idempotencyKey    String                    @unique
  qualifiedAt       DateTime?
  availableAt       DateTime?
  reversedAt        DateTime?
  paidAt            DateTime?
  reviewNote        String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  campaign      AffiliateCampaign     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  participation CampaignParticipation @relation(fields: [participationId], references: [id], onDelete: Restrict)
  influencer    User                  @relation("CommissionInfluencer", fields: [influencerUserId], references: [id], onDelete: Restrict)
  seller        User                  @relation("CommissionSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([influencerUserId, status])
  @@index([campaignId, status])
}

model SponsoredCampaign {
  id                   String                  @id @default(cuid())
  publicRef            String                  @unique
  advertiserUserId     String
  entityType           SponsoredEntityType
  entityId             String
  placement            SponsoredPlacement
  targetGameId         String?
  targetCategoryId     String?
  targetPlatform       String?
  targetRegion         String?
  startsAt             DateTime?
  endsAt               DateTime?
  totalBudgetCoins     BigInt
  remainingBudgetCoins BigInt
  dailyBudgetCoins     BigInt
  dailySpentCoins      BigInt                  @default(0)
  dailySpentOn         DateTime?
  cpcCoins             BigInt
  frequencyCap         Int                     @default(6)
  status               SponsoredCampaignStatus @default(DRAFT)
  reservationPublicRef String?
  impressionCount      Int                     @default(0)
  clickCount           Int                     @default(0)
  spendCoins           BigInt                  @default(0)
  lastShownAt          DateTime?
  moderationNote       String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  advertiser User             @relation(fields: [advertiserUserId], references: [id], onDelete: Cascade)
  events     SponsoredEvent[]

  @@index([status, placement])
  @@index([advertiserUserId, status])
}

model SponsoredEvent {
  id             String             @id @default(cuid())
  campaignId     String
  type           SponsoredEventType
  viewerUserId   String?
  viewerHash     String?
  amountCoins    BigInt             @default(0)
  idempotencyKey String             @unique
  suspicious     Boolean            @default(false)
  createdAt      DateTime           @default(now())

  campaign SponsoredCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, type, createdAt])
  @@index([viewerUserId, createdAt])
}

model PromotionNotice {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PromotionEvent {
  id              String   @id @default(cuid())
  type            String
  campaignId      String?
  participationId String?
  orderId         String?
  actorUserId     String?
  payloadJson     String   @default("{}")
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())

  @@index([type, createdAt])
  @@index([campaignId, createdAt])
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  RESERVED
  CANCELLED
}

enum BidStatus {
  ACTIVE
  OUTBID
  WON
  VOID
}

model Auction {
  id                String        @id @default(cuid())
  productId         String        @unique
  status            AuctionStatus @default(SCHEDULED)
  startingBidCents  Int
  minIncrementCents Int
  highBidCents      Int?
  bidCount          Int           @default(0)
  startsAt          DateTime
  endsAt            DateTime
  winnerUserId      String?
  reservedUntil     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  winner  User?   @relation("AuctionWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  bids    Bid[]

  @@index([status, endsAt])
  @@index([winnerUserId])
}

model Bid {
  id             String    @id @default(cuid())
  auctionId      String
  bidderUserId   String
  amountCents    Int
  status         BidStatus @default(ACTIVE)
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderUserId], references: [id], onDelete: Restrict)

  @@index([auctionId, amountCents])
  @@index([bidderUserId, createdAt])
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum GroupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Group {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  bio            String          @db.Text
  visibility     GroupVisibility @default(PUBLIC)
  taggingAllowed Boolean         @default(true)
  ownerUserId    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  owner        User               @relation("GroupOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members      GroupMember[]
  joinRequests GroupJoinRequest[]
  invitations  GroupInvitation[]
  bans         GroupBan[]
  posts        Post[]

  @@index([visibility, createdAt])
  @@index([ownerUserId])
}

model GroupMember {
  groupId   String
  userId    String
  role      GroupMemberRole @default(MEMBER)
  createdAt DateTime        @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model GroupJoinRequest {
  id        String             @id @default(cuid())
  groupId   String
  userId    String
  status    GroupRequestStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, status])
}

model GroupInvitation {
  id              String            @id @default(cuid())
  groupId         String
  invitedUserId   String
  invitedByUserId String
  status          GroupInviteStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitee   User  @relation("GroupInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("GroupInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@unique([groupId, invitedUserId])
  @@index([invitedUserId, status])
}

model GroupBan {
  groupId        String
  userId         String
  bannedByUserId String
  reason         String?
  createdAt      DateTime @default(now())

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User  @relation("GroupBanTarget", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy User  @relation("GroupBanActor", fields: [bannedByUserId], references: [id], onDelete: Restrict)

  @@id([groupId, userId])
  @@index([userId])
}

enum LfgRegion {
  NA
  EU
  SA
  AS
  OC
  AF
  ANY
}

enum LfgSkill {
  CASUAL
  INTERMEDIATE
  COMPETITIVE
  ANY
}

enum LfgMic {
  REQUIRED
  OPTIONAL
  NO_MIC
}

enum LfgStatus {
  OPEN
  FULL
  EXPIRED
  CANCELLED
}

enum LfgRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model LfgPost {
  id           String       @id @default(cuid())
  publicRef    String       @unique
  authorUserId String
  title        String
  body         String       @db.Text
  gameId       String
  platform     GamePlatform
  region       LfgRegion
  timezone     String
  skillLevel   LfgSkill
  mic          LfgMic
  availability String
  slotsTotal   Int
  slotsFilled  Int          @default(1)
  status       LfgStatus    @default(OPEN)
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  author   User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  game     Game         @relation(fields: [gameId], references: [id], onDelete: Restrict)
  requests LfgRequest[]

  @@index([status, expiresAt])
  @@index([gameId, createdAt])
  @@index([authorUserId])
}

model LfgRequest {
  id        String           @id @default(cuid())
  postId    String
  userId    String
  status    LfgRequestStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  post LfgPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, status])
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
}

enum PostModeration {
  LIVE
  HIDDEN
  REMOVED
}

enum PostMediaKind {
  IMAGE
  VIDEO
}

enum TagTargetType {
  USER
  SHOP
  GROUP
  PRODUCT
}

enum ReportTargetType {
  POST
  COMMENT
  STORY
  USER
  MESSAGE
  CONVERSATION
  TRADE
  SERVER
  AIDEN_ASSET
  DEV_PRODUCT
}

enum MessageKind {
  TEXT
  VOICE
  ATTACHMENT
  PRODUCT
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model UserFollow {
  followerUserId  String
  followingUserId String
  createdAt       DateTime @default(now())

  follower  User @relation("Following", fields: [followerUserId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingUserId], references: [id], onDelete: Cascade)

  @@id([followerUserId, followingUserId])
  @@index([followingUserId])
}

model UserBlock {
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

model Post {
  id               String         @id @default(cuid())
  publicRef        String         @unique
  authorUserId     String
  groupId          String?
  body             String         @db.Text
  visibility       PostVisibility @default(PUBLIC)
  moderationStatus PostModeration @default(LIVE)
  sponsored        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  author    User           @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  group     Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  media     SocialMedia[]
  comments  PostComment[]
  reactions PostReaction[]
  saves     PostSave[]
  tags      PostTag[]

  @@index([authorUserId, createdAt])
  @@index([groupId, createdAt])
  @@index([moderationStatus, createdAt])
}

model SocialMedia {
  id        String        @id @default(cuid())
  postId    String
  kind      PostMediaKind @default(IMAGE)
  url       String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model PostComment {
  id               String         @id @default(cuid())
  publicRef        String         @unique
  postId           String
  authorUserId     String
  body             String
  moderationStatus PostModeration @default(LIVE)
  createdAt        DateTime       @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PostReaction {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model PostSave {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model PostTag {
  id         String        @id @default(cuid())
  postId     String
  targetType TagTargetType
  targetSlug String
  createdAt  DateTime      @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, targetType, targetSlug])
  @@index([targetType, targetSlug])
}

model Story {
  id           String   @id @default(cuid())
  publicRef    String   @unique
  authorUserId String
  body         String
  mediaUrl     String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  author User        @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  views  StoryView[]

  @@index([authorUserId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
}

model ContentReport {
  id             String           @id @default(cuid())
  publicRef      String           @unique
  reporterUserId String
  targetType     ReportTargetType
  targetRef      String
  reason         String
  status         ReportStatus     @default(OPEN)
  createdAt      DateTime         @default(now())

  reporter User @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetRef])
}

model Conversation {
  id            String    @id @default(cuid())
  publicRef     String    @unique
  pairKey       String    @unique
  vanishMode    Boolean   @default(false)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id              String      @id @default(cuid())
  publicRef       String      @unique
  conversationId  String
  senderUserId    String
  kind            MessageKind @default(TEXT)
  body            String?
  vanish          Boolean     @default(false)
  mediaUrl        String?
  mediaDurationMs Int?
  productSlug     String?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
}

