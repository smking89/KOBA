  rotatedAt     DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  server      GameServer         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  integration ServerIntegration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

/// KOBA-issued rotatable API key for the Method B plugin channel — the
/// counterpart to ServerCredential's stored RCON password for the RCON
/// channel. Sealed with the same lib/crypto/secret-box.ts AES-256-GCM
/// round-trip ServerCredential's RCON password uses, and for the same
/// reason: KOBA has to recompute `hmac_sha256(secret, message)` itself
/// to verify a plugin's request signature, which needs the plaintext
/// secret, not just a one-way hash of it — a hash alone can verify a
/// password *submitted back*, but can't reconstruct an HMAC. One
/// active key per server; rotating revokes the prior one and the
/// plugin owner must update their config with the new secret, shown to
/// them exactly once at rotation time.
model ServerApiKey {
  id         String    @id @default(cuid())
  serverId   String    @unique
  keyPrefix  String
  ciphertext String    @db.Text
  iv         String
  authTag    String
  createdAt  DateTime  @default(now())
  rotatedAt  DateTime  @default(now())
  revokedAt  DateTime?

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

