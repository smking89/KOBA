generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KobaAccountType {
  PLAYER
  BUSINESS
  INFLUENCER
  SUPERADMIN
  ADMIN
  MODERATOR
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  SESSION_REVOKED
  KOBAID_MINTED
  ACCOUNT_SWITCHED
  KOBAID_ISSUED_STAFF
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  profile        AccountProfile?
  kobaIdentities KobaIdentity[]
  auditLogs      AuditLog[]     @relation("AuditActor")
  products       Product[]
  favorites      ProductFavorite[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AccountProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  displayName        String?
  activeAccountType  KobaAccountType  @default(PLAYER)
  kobaIdRevealedAt   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KobaIdentity {
  id          String          @id @default(cuid())
  code        String          @unique @db.VarChar(16)
  accountType KobaAccountType
  userId      String
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountType])
  @@index([code])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  action      AuditAction
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?     @db.VarChar(45)
  createdAt   DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

enum ProductRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  RELIC
}

enum ProductCategoryKind {
  SKINS
  MAPS
  MONUMENTS
  KITS
  COSMETICS
  SERVER_ASSETS
}

enum GamePlatform {
  PC
  STEAM
  XBOX
  PLAYSTATION
}

enum ModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ListingType {
  FIXED
  AUCTION
}

enum ProductMediaKind {
  IMAGE
  VIDEO
}

model Game {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  products  Product[]
}

model Category {
  id        String              @id @default(cuid())
  slug      String              @unique
  name      String
  kind      ProductCategoryKind
  createdAt DateTime            @default(now())
  products  Product[]
}

model Product {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  description        String           @db.Text
  rarity             ProductRarity
  rarityRank         Int
  listingType        ListingType      @default(FIXED)
  moderationStatus   ModerationStatus @default(DRAFT)
  priceCents         Int
  currency           String           @default("USD")
  inventoryQty       Int              @default(0)
  platforms          GamePlatform[]
  sellerUserId       String
  gameId             String
  categoryId         String
  publishedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  seller    User              @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)
  game      Game              @relation(fields: [gameId], references: [id], onDelete: Restrict)
  category  Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants  ProductVariant[]
  media     ProductMedia[]
  favorites ProductFavorite[]

  @@index([moderationStatus, publishedAt])
  @@index([gameId])
  @@index([categoryId])
  @@index([rarity])
  @@index([sellerUserId])
  @@index([priceCents])
  @@index([rarityRank])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  sku          String   @unique
  name         String
  priceCents   Int?
  inventoryQty Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductMedia {
  id        String           @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int              @default(0)
  kind      ProductMediaKind @default(IMAGE)
  createdAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductFavorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}
