  moderationNote     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  owner         User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  profile       DeveloperProfile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  installs      DevInstall[]
  versions      DevProductVersion[]
  entitlements  DevEntitlement[]
  purchases     DevPurchase[]
  reviews       DevProductReview[]

  @@index([ownerUserId])
  @@index([kind, reviewState])
  @@index([profileId, reviewState])
  @@index([category, reviewState])
  @@index([slug])
}

model DevInstall {
  id        String    @id @default(cuid())
  productId String
  userId    String
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  product DevProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
}

model DevProductVersion {
  id              String            @id @default(cuid())
  publicRef       String            @unique
  productId       String
  semver          String
  changelog       String            @default("") @db.Text
  channel         DevReleaseChannel @default(STABLE)
  gameVersions    String[]
  platforms       String[]
  requirements    String            @default("")
  reviewState     DevReviewState    @default(DRAFT)
  releasedAt      DateTime?
  deprecatedAt    DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  product   DevProduct           @relation(fields: [productId], references: [id], onDelete: Cascade)
  artifacts DevProductArtifact[]

  @@unique([productId, semver])
  @@index([productId, reviewState])
}

model DevProductArtifact {
  id            String            @id @default(cuid())
  versionId     String
  storageKey    String
  sha256        String
  byteSize      Int
  mimeType      String
  filename      String
  status        DevArtifactStatus @default(QUARANTINE)
  bytes         Bytes?
  createdAt     DateTime          @default(now())

  version DevProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, status])
}

model DevEntitlement {
  id        String    @id @default(cuid())
  userId    String
  productId String
  source    String
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product DevProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model DevPurchase {
  id                     String            @id @default(cuid())
  publicRef              String            @unique
  idempotencyKey         String            @unique
  buyerUserId            String
  productId              String
  priceCoins             BigInt
  feeCoins               BigInt
  sellerCoins            BigInt
  commissionBps          Int
  status                 DevPurchaseStatus @default(PAID)
  captureTxRef           String?
  sellerTxRef            String?
  refundTxRef            String?
  refundReason           String?
  proceedsUnrecoverable  Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  buyer   User       @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  product DevProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([buyerUserId, createdAt])
  @@index([productId, status])
}

model DevProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  body      String   @default("") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product DevProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
}
