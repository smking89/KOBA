  userId    String?
  kind      LedgerAccountKind
  bucket    CoinBucket?
  code      String
  createdAt DateTime          @default(now())

  wallet  CoinWallet?   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@unique([code])
  @@index([walletId])
  @@index([userId, kind])
}

model LedgerTransaction {
  id                 String         @id @default(cuid())
  publicRef          String         @unique
  idempotencyKey     String         @unique
  category           CoinTxCategory
  status             LedgerTxStatus @default(POSTED)
  memo               String
  actorUserId        String?
  walletId           String?
  externalRef        String?
  metadataJson       String?
  createdAt          DateTime       @default(now())
  postedAt           DateTime?
  reversedAt         DateTime?
  reversesTxId       String?        @unique
  reversedByTxId     String?        @unique

  wallet     CoinWallet?        @relation("WalletTransactions", fields: [walletId], references: [id], onDelete: SetNull)
  reverses   LedgerTransaction? @relation("LedgerReversal", fields: [reversesTxId], references: [id], onDelete: SetNull)
  reversedBy LedgerTransaction? @relation("LedgerReversal")
  entries    LedgerEntry[]
  reservationReserve  CoinReservation? @relation("ReservationReserveTx")
  reservationCapture  CoinReservation? @relation("ReservationCaptureTx")
  reservationRelease  CoinReservation? @relation("ReservationReleaseTx")

  @@index([category, createdAt])
  @@index([walletId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([status, createdAt])
}

model LedgerEntry {
  id            String          @id @default(cuid())
  transactionId String
  accountId     String
  side          LedgerEntrySide
  amount        BigInt
  classification CoinBucket?
  createdAt     DateTime        @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
}

model CoinReservation {
  id                 String                @id @default(cuid())
  publicRef          String                @unique
  walletId           String
  amount             BigInt
  /// JSON array of { bucket, amount } source allocations (immutable after ACTIVE).
  allocationsJson    String
  purpose            String
  status             CoinReservationStatus @default(PENDING)
  idempotencyKey     String                @unique
  expiresAt          DateTime?
  metadataJson       String?
  reserveTxId        String?               @unique
  captureTxId        String?               @unique
  releaseTxId        String?               @unique
  capturedAt         DateTime?
  releasedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  wallet     CoinWallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  reserveTx  LedgerTransaction? @relation("ReservationReserveTx", fields: [reserveTxId], references: [id], onDelete: SetNull)
  captureTx  LedgerTransaction? @relation("ReservationCaptureTx", fields: [captureTxId], references: [id], onDelete: SetNull)
  releaseTx  LedgerTransaction? @relation("ReservationReleaseTx", fields: [releaseTxId], references: [id], onDelete: SetNull)

  @@index([walletId, status])
  @@index([status, expiresAt])
}

enum CoinPurchaseStatus {
  PENDING
  PAID
  CANCELLED
}

/// A real-money purchase of a fixed Coin package via Stripe Checkout. Kept
/// separate from Order (marketplace purchases) since this is KOBA selling
/// its own Coins directly — no shop, no escrow, no seller payout: the
/// charge settles to and stays on KOBA's own Stripe balance. On payment
/// (webhook-driven only, same trust model as checkout.service.ts) this
/// credits the buyer's PURCHASED bucket via ledger.service.ts's
/// creditPurchasedCoins, using idempotencyKey as the ledger idempotency key
/// so a retried webhook can never double-credit.
model CoinPurchase {
  id                      String             @id @default(cuid())
  publicRef               String             @unique
  userId                  String
  packageId               String
  priceCents              Int
  coinAmount              BigInt
  currency                String             @default("USD")
  status                  CoinPurchaseStatus @default(PENDING)
  stripeCheckoutSessionId String?            @unique
  stripePaymentIntentId   String?
  idempotencyKey          String             @unique
  ledgerTransactionRef    String?
  paidAt                  DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
}

model AidenJob {
  id              String         @id @default(cuid())
  publicRef       String         @unique
  userId          String
  prompt          String         @db.Text
  game            String
  platform        String
  assetType       AidenAssetType
  state           AidenJobState  @default(QUEUED)
  coinCostPreview Int
  /// Actual Coin-equivalent cost reported by the frontier-model provider's
  /// usage response, once real providers are wired (features/aiden/providers).
  /// Recorded for audit/margin analysis only in this phase — the reservation
  /// is still always captured in full at coinCostPreview; reconciling the
  /// delta (releasing coinCostPreview - coinCostActual back to the wallet
  /// when the real cost is lower) is a deferred refinement, same pattern as
  /// this codebase's other "deferred: X" spots.
  coinCostActual  Int?
  /// Raw provider usage payload (tokens, compute units, whatever that
  /// provider's response shape is), stored as-is for audit. Null until a
  /// real (non-stub) provider is configured and actually called.
  frontierModelUsageJson String?     @db.Text
  reservationTxId String?
  failureReason   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset AidenAsset?

  @@index([userId, createdAt])
  @@index([state, createdAt])
}

model AidenAsset {
  id               String                @id @default(cuid())
  publicRef        String                @unique
  userId           String
  jobId            String?               @unique
  title            String
  assetType        AidenAssetType
  technicalStatus  AidenTechnicalStatus  @default(CONCEPT_ONLY)
  moderation       AidenModerationState  @default(PRIVATE)
  game             String
  previewLabel     String
  /// Generated output location (image/model/map file URL). Null for
  /// CONCEPT_ONLY assets and anything created before real generation existed.
  assetUrl         String?
  /// Set once this asset has been published to the marketplace as a
  /// Product (features/aiden/services/aiden.service.ts's
  /// publishAssetToMarketplace). Null means never published; presence
  /// blocks re-publishing the same asset as a second listing. The
  /// created Product still starts DRAFT and goes through the same
  /// seller submit -> staff review pipeline as any other listing — this
  /// is lineage tracking, not a moderation bypass.
  publishedProductId String?              @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             AidenJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  publishedProduct Product? @relation(fields: [publishedProductId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([moderation])
}

model DevProduct {
  id            String         @id @default(cuid())
  publicRef     String         @unique
  ownerUserId   String
  kind          DevProductKind
  name          String
  pricing       DevPricing     @default(FREE)
  priceCents    Int            @default(0)
  version       String         @default("0.1.0")
  compatibility String[]
  scopes        String[]
  reviewState   DevReviewState @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  owner    User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  installs DevInstall[]

  @@index([ownerUserId])
  @@index([kind, reviewState])
}

model DevInstall {
  id        String   @id @default(cuid())
  productId String
  userId    String
  revokedAt DateTime?
  createdAt DateTime @default(now())

  product DevProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
}
