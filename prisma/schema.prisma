  accounts                        Account[]
  sessions                        Session[]
  profile                         AccountProfile?
  kobaIdentities                  KobaIdentity[]
  auditLogs                       AuditLog[]                @relation("AuditActor")
  staffMfaFactor                  StaffMfaFactor?
  staffMfaChallenges              StaffMfaChallenge[]
  staffSessions                   StaffSession[]
  platformFunctionFlagUpdates     PlatformFunctionFlag[]    @relation("PlatformFunctionFlagUpdatedBy")
  boostsOwned                     Boost[]                   @relation("BoostOwner")
