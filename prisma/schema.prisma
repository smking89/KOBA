model GameServer {
  id              String                @id @default(cuid())
  publicRef       String                @unique
  slug            String                @unique
  name            String
  game            String
  platformFamily  ServerPlatformFamily
  region          String
  tags            String[]
  ownerUserId     String
  shopId          String?
  joinInfo        String?
  lastRefreshAt   DateTime?
  capabilities    ServerCapability[]
  status          ServerOnlineStatus    @default(UNKNOWN)
  livePlayers     Int?
  maxPlayers      Int?
  queue           Int?
  mapName         String?
  mapSize         String?
  pingMs          Int?
  host            String?
  port            Int?
  rconTestState   RconTestState         @default(IDLE)
  /// "Rarity" for a server (client clarification, 2026-08-15): derived
  /// from a Map they own on this server, purchased on the KOBA
  /// marketplace — NOT a standalone server-level tier the owner just
  /// sets. Nullable: a server with no active map has no rarity to show.
  /// Must reference an InventoryItem the server's owner actually owns
  /// (features/servers/services/server.service.ts#setActiveMap
  /// enforces this — schema alone can't express "owned by the same
  /// user as ownerUserId").
  activeMapInventoryItemId String? @unique
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  owner            User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  shop             Shop?            @relation(fields: [shopId], references: [id], onDelete: SetNull)
  credential       ServerCredential?
  bios             ServerBio[]
  activeMapInventoryItem InventoryItem? @relation(fields: [activeMapInventoryItemId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([game, region])
  @@index([platformFamily])
