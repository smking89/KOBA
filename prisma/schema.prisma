model LedgerTransaction {
  id                 String         @id @default(cuid())
  publicRef          String         @unique
  idempotencyKey     String         @unique
  category           CoinTxCategory
  status             LedgerTxStatus @default(POSTED)
  memo               String
  actorUserId        String?
  walletId           String?
  externalRef        String?
  metadataJson       String?
  createdAt          DateTime       @default(now())
  postedAt           DateTime?
  reversedAt         DateTime?
  reversesTxId       String?        @unique
  reversedByTxId     String?        @unique

  wallet     CoinWallet?        @relation("WalletTransactions", fields: [walletId], references: [id], onDelete: SetNull)
  reverses   LedgerTransaction? @relation("LedgerReversal", fields: [reversesTxId], references: [id], onDelete: SetNull)
  reversedBy LedgerTransaction? @relation("LedgerReversal")
  entries    LedgerEntry[]
  reservationReserve  CoinReservation? @relation("ReservationReserveTx")
  reservationCapture  CoinReservation? @relation("ReservationCaptureTx")
  reservationRelease  CoinReservation? @relation("ReservationReleaseTx")

  @@index([category, createdAt])
  @@index([walletId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([status, createdAt])
}

model LedgerEntry {
  id            String          @id @default(cuid())
