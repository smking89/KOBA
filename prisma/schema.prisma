model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * "Continue with Discord/Steam/Google" sign-in identities (client,
 * 2026-08-17: "for the login and register pages, we need oauth").
 * Deliberately separate from `Account` above (the unused Auth.js-Adapter
 * shape already in this schema) and from `UserSocialConnection` (bio
 * badges) — this table's only job is "which User does this provider
 * identity log in as," enforced one-to-one both ways. No auto-linking by
 * email: a provider identity not already in this table, whose email
 * matches an existing User, is refused (features/auth-oauth), not
 * silently merged.
 */
enum LoginOAuthProvider {
  DISCORD
  GOOGLE
  STEAM
}

model UserLoginIdentity {
  id             String             @id @default(cuid())
  userId         String
  provider       LoginOAuthProvider
  providerUserId String
  createdAt      DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
}

/**
 * One-time ticket handing an OAuth callback (no client-side password) off
 * to the existing Credentials provider, which is the only thing allowed
 * to mint a NextAuth session — mirrors StaffMfaChallenge's
 * session-issue ticket pattern in features/staff-mfa.
 */
model OAuthLoginTicket {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// OAuth 2.0 Device Authorization Grant (RFC 8628) — Phase 21's
/// foundational gap: Auth.js sessions are browser cookies only, but a
/// desktop plugin (and later, Phase 22's Discord bot) has no browser to
/// hold one. The device flow instead has the client show a short
/// `userCode`, the person approves it on `/oauth/authorize` in their
/// actual browser (an already-authenticated session), and the client
/// polls `/api/oauth/device/token` until it resolves. `clientKey`
/// identifies which first-party client this is (validated against
/// features/oauth-device/lib/clients.ts, not a DB-registered OAuth
/// client — KOBA doesn't support third-party OAuth apps).
enum OAuthDeviceGrantStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

model OAuthDeviceGrant {
  id                  String                 @id @default(cuid())
  deviceCodeHash      String                 @unique
  userCode            String                 @unique
  clientKey           String
  scopes              String[]
  status              OAuthDeviceGrantStatus @default(PENDING)
  userId              String?
  pollIntervalSeconds Int                    @default(5)
  lastPolledAt        DateTime?
  expiresAt           DateTime
  createdAt           DateTime               @default(now())
  approvedAt          DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Long-lived bearer token a device-flow client uses afterward —
/// features/oauth-device/lib/access-token.ts resolves the
/// `Authorization: Bearer` header against this table, the non-browser
/// equivalent of a NextAuth session cookie.
model OAuthAccessToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  clientKey String
  scopes    String[]
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Proof a KOBA user controls a given Steam account — Steam's own OpenID
/// login (features/auth-oauth/lib/steam.ts, shared with login-OAuth),
/// not a koba-issued credential. The PC Plugin uses this to know which
/// local Steam install to read/write skins for.
model SteamAccountLink {
  id          String   @id @default(cuid())
  userId      String   @unique
  steamId64   String   @unique
  personaName String?
  linkedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Console platform identity links (client, 2026-08-18: "koba needs to
/// have users connect there gamertag, psn, steam via there dashboard
/// before buying anything" on a game-delivered item — clarified in the
/// same breath that KOBAID is what proves ownership; these fields exist
/// purely so KOBA/Discord bots/the PC Plugin "know who is who" for
/// delivery routing, not as ownership proof). Self-reported, no OAuth —
/// confirmed via AskUserQuestion: Xbox Live/PSN have no public
/// ownership-verification API the way Steam's OpenID does, and none is
/// needed since KOBAID already answers "do they actually own this."
model XboxAccountLink {
  id       String   @id @default(cuid())
  userId   String   @unique
  gamertag String   @unique
  linkedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlayStationAccountLink {
  id          String   @id @default(cuid())
  userId      String   @unique
  psnUsername String   @unique
  linkedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum TagPrivacy {
  EVERYONE
  FOLLOWERS
  NO_ONE
}

model AccountProfile {
  id                String          @id @default(cuid())
  userId            String          @unique
  handle            String          @unique
  displayName       String?
  bio               String?
  activeAccountType KobaAccountType @default(PLAYER)
  tagPrivacy        TagPrivacy      @default(FOLLOWERS)
  kobaIdRevealedAt  DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KobaIdentity {
  id          String          @id @default(cuid())
  code        String          @unique @db.VarChar(16)
  accountType KobaAccountType
  userId      String
  createdAt   DateTime        @default(now())

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plusSubscription  PlusSubscription?
  plusGrants        PlusEntitlementGrant[]
  aidenJobs         AidenJob[]
  developerProfiles DeveloperProfile[]

  @@unique([userId, accountType])
  @@index([code])
}

// prevHash/hash form a tamper-evident hash chain: each row's hash commits to
// its own fields plus the previous row's hash, so editing or deleting a past
// entry breaks the chain from that point forward (detectable via
// verifyAuditChain() in audit-log.service.ts). Rows written before this
// chaining was added have null prevHash/hash — the chain is considered to
// start fresh at the first non-null row.
model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  action      AuditAction
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?     @db.VarChar(45)
  createdAt   DateTime    @default(now())
  prevHash    String?     @db.VarChar(64)
  hash        String?     @db.VarChar(64)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

// One row per PlatformFunctionKey. Absence of a row means "enabled" (the
// default, so shipping a new function doesn't require a migration to turn
// it on) — only an explicit row with enabled=false blocks the function.
// Runtime callers use isPlatformFunctionEnabled(), which fails CLOSED
// (treats the function as disabled) if the DB read itself errors, since
// this guards real money/API-cost paths and a silent bypass on DB outage
// would be worse than a false block.
model PlatformFunctionFlag {
  id              String              @id @default(cuid())
  key             PlatformFunctionKey @unique
  enabled         Boolean             @default(true)
  note            String?
  updatedByUserId String?
  updatedAt       DateTime            @updatedAt
  createdAt       DateTime            @default(now())

  updatedBy User? @relation("PlatformFunctionFlagUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([key])
}

// Boost target kind — deliberately extensible ("or any supported
// feature" per client direction). Adding a new boostable surface (e.g.
// LFG posts) is a new enum value + a new case in
// features/boost/services/boost.service.ts's ownership check, not a
// schema rewrite.
enum BoostTargetKind {
  PRODUCT
  SHOP
  GROUP
  SERVER
  INFLUENCER
}

enum BoostStatus {
  UNUSED
  APPLIED
  EXPIRED
}

// A Boost is a purchasable, held item (like Coins, it sits in the
// buyer's wallet until spent) rather than a live ad campaign. Fixed
// effect (see features/boost/lib/pricing.ts: 10 minutes, 3x exposure —
// both client-specified, not configurable per-purchase). Follows the
// AuditLog.targetType/targetId string-pair convention for its
// polymorphic target rather than three nullable FK columns, since this
// codebase already uses that pattern for exactly this kind of
// "one row can point at several different entity types" case.
model Boost {
  id               String           @id @default(cuid())
  ownerUserId      String
  status           BoostStatus      @default(UNUSED)
  purchaseCoinCost Int
  purchasedAt      DateTime         @default(now())
  giftedFromUserId String?
  giftedAt         DateTime?
  targetType       BoostTargetKind?
  targetId         String?
  appliedAt        DateTime?
  expiresAt        DateTime?
  idempotencyKey   String           @unique

  owner      User  @relation("BoostOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  giftedFrom User? @relation("BoostGiftedFrom", fields: [giftedFromUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([targetType, targetId])
}

enum ProductRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  RELIC
}

enum ProductCategoryKind {
  SKINS
  MAPS
  MONUMENTS
  KITS
  COSMETICS
  SERVER_ASSETS
}

enum GamePlatform {
  PC
  STEAM
  XBOX
  PLAYSTATION
}

enum ModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ListingType {
  FIXED
  AUCTION
  /// Client, 2026-08-18 (KOBA-vs-Tip4Serv architecture spec): "the
  /// platform must track active subscriptions. Upon a Stripe
  /// cancellation or failed payment webhook, the system must
  /// auto-queue 'Expiry Commands.'" A recurring per-server VIP-rank
  /// purchase — Stripe Checkout in subscription mode instead of
  /// one-time payment. See ProductSubscription.
  SUBSCRIPTION
}

enum ProductSubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum ProductMediaKind {
  IMAGE
  VIDEO
}

/// Per-game marketplace-content policy, derived from the ARK deep-dive +
/// per-title ToS sweep (2026-08-14). Desk research, not legal counsel — see
/// docs/game-content-policy.md. FULL = mods/maps/kits/skins all allowed.
/// SKINS_ONLY = only Category.kind = SKINS listings allowed (in-game
/// character/item skins — the actual thing publisher policies like
/// Minecraft's mean by "cosmetics/perks are the sanctioned path"; mods/
/// maps/kits are not). EXCLUDED = no listings of any kind — a sourced,
/// direct conflict with the publisher's stated policy. LEGAL_REVIEW = no
/// public policy found either direction; blocked pending actual legal
/// counsel or direct publisher contact, not desk-research clearance.
/// NOTE: Category.kind = COSMETICS and the separate Cosmetic model
/// (avatar decorations, profile effects, nameplates, profile frames, shop
/// banners, emojis — KOBA's own subscription-style profile/shop
/// customization) are never game-specific and are NEVER gated by this
/// policy at all.
enum GameContentPolicy {
  FULL
  SKINS_ONLY
  EXCLUDED
  LEGAL_REVIEW
}

model Game {
  id            String            @id @default(cuid())
  slug          String            @unique
  name          String
  contentPolicy GameContentPolicy @default(FULL)
  /// Human-readable citation for contentPolicy, shown to sellers/staff —
  /// e.g. "Wildcard's CurseForge moderation guidelines mandate Tebex-only
  /// payout for monetized mods; conflicts with KOBA's Stripe Connect
  /// architecture." Null only for FULL-policy games with nothing to cite.
  policyNote    String?
  createdAt     DateTime          @default(now())
  products      Product[]
  lfgPosts      LfgPost[]
}

model Category {
  id        String              @id @default(cuid())
  slug      String              @unique
  name      String
  kind      ProductCategoryKind
  createdAt DateTime            @default(now())
  products  Product[]
}

/// Freebie policy (ROADMAP.md Phase 18): NONE = normal paid listing.
/// PERMANENT = always free, no quantity limit. LIMITED_QUANTITY = free
/// for the first `freebieQuantityRemaining` claims, then reverts to
/// `priceCents` as a normal paid listing. Deliberately NOT a separate
/// $0-price convention (priceCents already allows 0) — freebiePolicy
/// disambiguates "genuinely free" from "a seller priced this at zero,"
/// which are different things (a $0 non-freebie product would still go
/// through paid checkout's Stripe flow, wastefully, for no money moved).
enum FreebiePolicy {
  NONE
  PERMANENT
  LIMITED_QUANTITY
}

model Product {
  id                       String            @id @default(cuid())
  slug                     String            @unique
  title                    String
  description              String            @db.Text
  rarity                   ProductRarity
  rarityRank               Int
  listingType              ListingType       @default(FIXED)
  moderationStatus         ModerationStatus  @default(DRAFT)
  priceCents               Int
  currency                 String            @default("USD")
  inventoryQty             Int               @default(0)
  platforms                GamePlatform[]
  sellerUserId             String
  shopId                   String?
  gameId                   String
  categoryId               String
  publishedAt              DateTime?
  freebiePolicy            FreebiePolicy     @default(NONE)
  /// Meaningful only when freebiePolicy = LIMITED_QUANTITY — a one-time
  /// lifetime pool per product (client direction not yet given on
  /// replenishment; "first 15 free" is modeled as never resetting,
  /// flagged in ROADMAP.md as the default, not a guess left unstated).
  /// Decrements independently of inventoryQty, which also decrements on
  /// a free claim (a free claim still consumes real stock).
  freebieQuantityRemaining Int?
  /// Direct-RCON auto-delivery (client, 2026-08-18: "we need a system
  /// like tip4serv" — direct-RCON channel confirmed first via
  /// AskUserQuestion). Both null = no auto-delivery, manual fulfillment
  /// like any other listing. Set together: which of the seller's own
  /// GameServers receives the command, and the Oxide/uMod kit name
  /// (features/servers/lib/rcon/kit-commands.ts) it runs
  /// `kit givetoplayer` for.
  rconServerId             String?
  rconKitName              String?
  /// Subscription-only fields (listingType SUBSCRIPTION). rconServerId/
  /// rconKitName double as the *grant* command here (same auto-delivery
  /// machinery as a one-time RCON listing — RconCommandJob doesn't care
  /// whether it's chained off an Order or a ProductSubscription).
  /// expiryKitName is the counterpart *revoke* command, run the instant
  /// Stripe reports a cancellation or failed payment — client's own
  /// spec wording, not a guess. subscriptionInterval/stripePriceId are
  /// set together with the above when a seller publishes a
  /// subscription listing (features/shops/services/product-admin.service.ts
  /// lazily creates the Stripe Price).
  subscriptionInterval     PlusPlanInterval?
  expiryKitName            String?
  stripePriceId            String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  seller            User                       @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)
  shop              Shop?                      @relation(fields: [shopId], references: [id], onDelete: SetNull)
  game              Game                       @relation(fields: [gameId], references: [id], onDelete: Restrict)
  category          Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  rconServer        GameServer?                @relation("ProductRconServer", fields: [rconServerId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  media             ProductMedia[]
  favorites         ProductFavorite[]
  saves             ProductSave[]
  orderItems        OrderItem[]
  auction           Auction?
  referralCodes     ReferralCode[]
  subscriptions     ProductSubscription[]
  campaignProducts  AffiliateCampaignProduct[]
  promoCodeProducts PromoCodeProduct[]
  aidenAsset        AidenAsset?
  freebieClaims     FreebieClaim[]
  comments          ProductComment[]

  @@index([moderationStatus, publishedAt])
  @@index([gameId])
  @@index([categoryId])
  @@index([rarity])
  @@index([sellerUserId])
  @@index([shopId])
  @@index([priceCents])
  @@index([rarityRank])
  @@index([freebiePolicy])
}

/// One row per successful free claim — enforces one-claim-per-buyer
