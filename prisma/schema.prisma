// Plus perk: a bio that can differ per game-server community, distinct
// from AccountProfile.bio (account-wide). Gated to active Plus
// subscribers at the service layer, not enforced at the schema level
// (same pattern as every other perk gate in this codebase).
model ServerBio {
  id           String   @id @default(cuid())
  userId       String
  gameServerId String
  bio          String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  server GameServer @relation(fields: [gameServerId], references: [id], onDelete: Cascade)

  @@unique([userId, gameServerId])
  @@index([gameServerId])
}

model CoinWallet {
  id                 String           @id @default(cuid())
  userId             String           @unique
  status             CoinWalletStatus @default(ACTIVE)
  currency           CoinCurrency     @default(KOBA_COIN)
  version            Int              @default(0)
  /// Projection caches — ledger entries remain source of truth.
  purchasedBalance   BigInt           @default(0)
  promotionalBalance BigInt           @default(0)
  earnedBalance      BigInt           @default(0)
  reservedBalance    BigInt           @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts     LedgerAccount[]
  reservations CoinReservation[]
  transactions LedgerTransaction[] @relation("WalletTransactions")
}

model LedgerAccount {
  id        String            @id @default(cuid())
  walletId  String?
  userId    String?
  kind      LedgerAccountKind
  bucket    CoinBucket?
  code      String
  createdAt DateTime          @default(now())

  wallet  CoinWallet?   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@unique([code])
  @@index([walletId])
  @@index([userId, kind])
}

model LedgerTransaction {
  id             String         @id @default(cuid())
  publicRef      String         @unique
  idempotencyKey String         @unique
  category       CoinTxCategory
  status         LedgerTxStatus @default(POSTED)
  memo           String
  actorUserId    String?
  walletId       String?
  externalRef    String?
  metadataJson   String?
  createdAt      DateTime       @default(now())
  postedAt       DateTime?
  reversedAt     DateTime?
  reversesTxId   String?        @unique
  reversedByTxId String?        @unique

  wallet             CoinWallet?        @relation("WalletTransactions", fields: [walletId], references: [id], onDelete: SetNull)
  reverses           LedgerTransaction? @relation("LedgerReversal", fields: [reversesTxId], references: [id], onDelete: SetNull)
  reversedBy         LedgerTransaction? @relation("LedgerReversal")
  entries            LedgerEntry[]
  reservationReserve CoinReservation?   @relation("ReservationReserveTx")
  reservationCapture CoinReservation?   @relation("ReservationCaptureTx")
  reservationRelease CoinReservation?   @relation("ReservationReleaseTx")

  @@index([category, createdAt])
  @@index([walletId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([status, createdAt])
}

model LedgerEntry {
  id             String          @id @default(cuid())
  transactionId  String
  accountId      String
  side           LedgerEntrySide
  amount         BigInt
  classification CoinBucket?
  createdAt      DateTime        @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
}

model CoinReservation {
  id              String                @id @default(cuid())
  publicRef       String                @unique
  walletId        String
  amount          BigInt
  /// JSON array of { bucket, amount } source allocations (immutable after ACTIVE).
  allocationsJson String
  purpose         String
  status          CoinReservationStatus @default(PENDING)
  idempotencyKey  String                @unique
  expiresAt       DateTime?
  metadataJson    String?
  reserveTxId     String?               @unique
  captureTxId     String?               @unique
  releaseTxId     String?               @unique
  capturedAt      DateTime?
  releasedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  wallet    CoinWallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  reserveTx LedgerTransaction? @relation("ReservationReserveTx", fields: [reserveTxId], references: [id], onDelete: SetNull)
  captureTx LedgerTransaction? @relation("ReservationCaptureTx", fields: [captureTxId], references: [id], onDelete: SetNull)
  releaseTx LedgerTransaction? @relation("ReservationReleaseTx", fields: [releaseTxId], references: [id], onDelete: SetNull)

  @@index([walletId, status])
  @@index([status, expiresAt])
}

enum CoinPurchaseStatus {
  PENDING
  PAID
  CANCELLED
}

/// A real-money purchase of a fixed Coin package via Stripe Checkout. Kept
/// separate from Order (marketplace purchases) since this is KOBA selling
/// its own Coins directly — no shop, no escrow, no seller payout: the
/// charge settles to and stays on KOBA's own Stripe balance. On payment
/// (webhook-driven only, same trust model as checkout.service.ts) this
/// credits the buyer's PURCHASED bucket via ledger.service.ts's
/// creditPurchasedCoins, using idempotencyKey as the ledger idempotency key
/// so a retried webhook can never double-credit.
model CoinPurchase {
  id                      String             @id @default(cuid())
  publicRef               String             @unique
  userId                  String
  packageId               String
  priceCents              Int
  coinAmount              BigInt
  currency                String             @default("USD")
  status                  CoinPurchaseStatus @default(PENDING)
  stripeCheckoutSessionId String?            @unique
  stripePaymentIntentId   String?
  idempotencyKey          String             @unique
  ledgerTransactionRef    String?
  paidAt                  DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
}

model AidenJob {
  id                     String                @id @default(cuid())
  publicRef              String                @unique
  userId                 String
  kobaIdentityId         String?
  prompt                 String                @db.Text
  promptHash             String?
  game                   String
  platform               String
  assetType              AidenAssetType
  settingsJson           String                @default("{}")
  state                  AidenJobState         @default(QUEUED)
  coinCostPreview        Int
  /// Actual Coin-equivalent cost reported by the frontier-model provider's
  /// usage response, once real providers are wired (features/aiden/providers).
  /// Recorded for audit/margin analysis only in this phase — the reservation
  /// is still always captured in full at coinCostPreview; reconciling the
  /// delta (releasing coinCostPreview - coinCostActual back to the wallet
  /// when the real cost is lower) is a deferred refinement, same pattern as
  /// this codebase's other "deferred: X" spots.
  coinCostActual         Int?
  /// Raw provider usage payload (tokens, compute units, whatever that
  /// provider's response shape is), stored as-is for audit. Null until a
  /// real (non-stub) provider is configured and actually called.
  frontierModelUsageJson String?               @db.Text
  estimatedCostCoins     BigInt                @default(0)
  actualCostCoins        BigInt?
  reservationPublicRef   String?
  reservationTxId        String?
  provider               String                @default("mock")
  model                  String                @default("aiden-mock-concept")
  modelVersion           String                @default("1")
  providerRequestId      String?               @unique
  idempotencyKey         String?               @unique
  promptModeration       AidenPromptModeration @default(PENDING)
  outputModeration       AidenOutputModeration @default(PENDING)
  failureReason          String?
  failureClass           AidenFailureClass?
  attempts               Int                   @default(0)
  maxAttempts            Int                   @default(3)
  runAfter               DateTime              @default(now())
  claimedAt              DateTime?
  claimedBy              String?
  version                Int                   @default(0)
  outputStorageKey       String?
  outputMime             String?
  outputBytes            Bytes?
  outputByteSize         Int?
  outputWidth            Int?
  outputHeight           Int?
  cancelRequestedAt      DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity KobaIdentity? @relation(fields: [kobaIdentityId], references: [id], onDelete: SetNull)
  asset    AidenAsset?

  @@index([userId, createdAt])
  @@index([state, runAfter])
  @@index([state, claimedAt])
}

model AidenAsset {
  id                 String               @id @default(cuid())
  publicRef          String               @unique
  userId             String
  jobId              String?              @unique
  title              String
  assetType          AidenAssetType
  technicalStatus    AidenTechnicalStatus @default(CONCEPT_ONLY)
  moderation         AidenModerationState @default(PRIVATE)
  game               String
  previewLabel       String
  storageKey         String?
  mimeType           String?
  byteSize           Int?
  width              Int?
  height             Int?
  provider           String?
  model              String?
  modelVersion       String?
  provenanceJson     String?
  /// Generated output location (image/model/map file URL). Null for
  /// CONCEPT_ONLY assets and anything created before real generation existed.
  assetUrl           String?
  /// Set once this asset has been published to the marketplace as a
  /// Product (features/aiden/services/aiden.service.ts's
  /// publishAssetToMarketplace). Null means never published; presence
  /// blocks re-publishing the same asset as a second listing. The
  /// created Product still starts DRAFT and goes through the same
  /// seller submit -> staff review pipeline as any other listing — this
  /// is lineage tracking, not a moderation bypass.
  publishedProductId String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job              AidenJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  publishedProduct Product?  @relation(fields: [publishedProductId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([moderation])
}

// Verified social account badges on user and shop bios (2026-08-18:
// "for the social media icons in shop bios, and user bios, they need
// auth to connect their accounts"). Two dedicated models rather than one
// polymorphic table with nullable owner columns — this schema doesn't
// use polymorphic associations anywhere else, and a single nullable-FK
// table can't cleanly express "exactly one owner, unique per (owner,
// provider)" with Prisma's declarative unique constraints. Separate
// from DeveloperProfile's own discordUserId/discordUsername fields
// (features/developers/lib/discord-oauth.ts) — that one exists
// specifically for bot-ownership verification context, not bio display,
// and isn't being unified into this table.
enum SocialProvider {
  DISCORD
  TWITTER
  YOUTUBE
  TWITCH
}

model UserSocialConnection {
  id               String         @id @default(cuid())
  userId           String
  provider         SocialProvider
  providerUserId   String
  providerUsername String
  profileUrl       String?
  connectedAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model ShopSocialConnection {
  id               String         @id @default(cuid())
  shopId           String
  provider         SocialProvider
  providerUserId   String
  providerUsername String
  profileUrl       String?
  connectedAt      DateTime       @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, provider])
  @@index([shopId])
}

/// Business-level blacklist (client, 2026-08-18: "we need a blacklist
/// function both for superadmin role, and business accounts"). Bans the
/// whole person, not one KOBAID (confirmed via AskUserQuestion) — every
/// KOBAID that user holds is blocked from this shop, closing the
/// "just switch account type" evasion. Enforced today at every KOBA-side
/// interaction with this shop (checkout, freebie claims, follows,
/// reviews) — this is a strict superset of what future PC-server-join
/// and Discord-guild-kick enforcement will add once that infrastructure
/// exists (Phase 22's bot, per-game RCON ban commands); `requestSocialRemoval`
/// records the shop's *intent* for that follow-up, not a live action.
model ShopBlacklistEntry {
  id                   String   @id @default(cuid())
  shopId               String
  targetUserId         String
  reason               String   @db.Text
  hashtags             String[]
  requestSocialRemoval Boolean  @default(false)
  createdByUserId      String
  createdAt            DateTime @default(now())

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  targetUser User @relation("ShopBlacklistTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdBy  User @relation("ShopBlacklistCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([shopId, targetUserId])
  @@index([targetUserId])
}

enum PlatformBlacklistTargetType {
  USER
  SHOP
}

/// Superadmin platform-wide ban/blacklist — stricter than a shop's own
/// (client: "if user is added to blacklist by superadmin its stricter,
/// they get banned the same way but also from the koba platforms").
/// USER-type entries fully lock the account out of signing in (checked
/// in lib/auth/credentials-provider.ts's sessionUserFromId, the one
/// choke point every login path — password, staff MFA ticket, and OAuth
/// ticket — already funnels through). SHOP-type entries ban a storefront
/// itself, confirmed in scope via AskUserQuestion.
model PlatformBlacklistEntry {
  id                   String                      @id @default(cuid())
  targetType           PlatformBlacklistTargetType
  targetUserId         String?
  targetShopId         String?
  reason               String                      @db.Text
  hashtags             String[]
  requestSocialRemoval Boolean                     @default(false)
  createdByUserId      String
  createdAt            DateTime                    @default(now())

  targetUser User? @relation("PlatformBlacklistTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetShop Shop? @relation("PlatformBlacklistTargetShop", fields: [targetShopId], references: [id], onDelete: Cascade)
  createdBy  User  @relation("PlatformBlacklistCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([targetUserId])
  @@unique([targetShopId])
  @@index([targetType])
}

model DeveloperProfile {
  id                 String    @id @default(cuid())
