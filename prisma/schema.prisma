/// Durable RCON delivery queue (client, 2026-08-18: "if a target game
/// server is offline, down, or experiencing lag, the KOBA gateway must
/// cache the commands in a database queue and safely retry execution
/// using an exponential backoff strategy until success is confirmed").
/// One row per delivery attempt-chain for one order — created the
/// instant an order with an rconKitName product is marked PAID, and
/// re-created fresh on a seller-triggered redeliver. The happy path
/// (server online) still resolves on the very first attempt, executed
/// inline from deliverRconKitForOrder for the same instant-delivery
/// feel Tip4Serv has; only a transient failure (TIMEOUT) hands the job
/// off to the worker for backoff retry — a non-retryable failure
/// (AUTH_FAILED, UNSUPPORTED) goes straight to FAILED, no point
/// queueing a retry a seller config change is what actually fixes.
/// Client, 2026-08-18 (Method B): orderId is nullable and
/// productSubscriptionId was added so the same job/queue/worker also
/// carries subscription grant/expiry commands — exactly one of the two
/// is ever set (enforced in application code, not the schema; Postgres
/// CHECK constraints aren't worth hand-writing into a migration for
/// this). A grant job's kitName comes from Product.rconKitName, an
/// expiry job's from Product.expiryKitName — the job itself doesn't
/// know or care which, it just runs whatever command it was given.
model RconCommandJob {
  id                    String               @id @default(cuid())
  orderId               String?
  productSubscriptionId String?
  serverId              String
  kitName               String
  gamertag              String
  status                RconCommandJobStatus @default(PENDING)
  attempts              Int                  @default(0)
  runAfter              DateTime             @default(now())
  lastError             String?              @db.Text
  correlationId         String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  order               Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSubscription ProductSubscription? @relation(fields: [productSubscriptionId], references: [id], onDelete: Cascade)
  server              GameServer           @relation("RconCommandJobServer", fields: [serverId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([orderId])
  @@index([productSubscriptionId])
}

/// One buyer's recurring per-server VIP-rank purchase (ListingType
/// SUBSCRIPTION). Created INCOMPLETE the moment Stripe Checkout starts
/// (mirrors PlusSubscription's pending-row-then-webhook-flips pattern),
/// flipped ACTIVE by checkout.session.completed, which also enqueues
/// the initial grant RconCommandJob. Client's spec, verbatim: "Upon a
/// Stripe cancellation or failed payment webhook, the system must
/// auto-queue 'Expiry Commands' (e.g., removing a player from a VIP
/// permission group)" — both customer.subscription.deleted and
/// invoice.payment_failed immediately enqueue the expiry job and flip
/// status, no grace period, matching that wording exactly.
model ProductSubscription {
  id                   String                    @id @default(cuid())
  publicRef            String                    @unique
  productId            String
  shopId               String
  buyerUserId          String
  serverId             String
  gamertag             String
  stripeCustomerId     String?
  stripeSubscriptionId String?                   @unique
  status               ProductSubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  product  Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  shop     Shop                         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  buyer    User                         @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  server   GameServer                   @relation("ProductSubscriptionServer", fields: [serverId], references: [id], onDelete: Restrict)
  invoices ProductSubscriptionInvoice[]
  jobs     RconCommandJob[]

  @@index([buyerUserId])
  @@index([shopId, status])
}

/// One paid Stripe invoice for a ProductSubscription — the renewal
/// ledger + Connect payout record. Settles instantly on
/// invoice.payment_succeeded (a direct stripe.transfers.create split
/// via splitPayment, same math as one-time checkout) rather than going
/// through the one-time-purchase OrderEscrow hold/dispute window: a
/// recurring low-value VIP renewal is a different risk profile than a
/// one-off marketplace good, and Order's schema (auction fields,
/// OrderItem, freebie fields, ...) doesn't fit a recurring line item
/// cleanly — a dedicated ledger row is a better fit than overloading
/// Order. The very first invoice (billing_reason
/// "subscription_create") is NOT recorded here — that one is already
/// covered by the checkout.session.completed → ACTIVE transition; this
/// table only holds renewal cycles.
model ProductSubscriptionInvoice {
  id                  String   @id @default(cuid())
  subscriptionId      String
  stripeInvoiceId     String   @unique
  amountCents         Int
  applicationFeeCents Int
  sellerPayoutCents   Int
  currency            String
  stripeTransferId    String?
  createdAt           DateTime @default(now())

  subscription ProductSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

