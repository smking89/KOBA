generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KobaAccountType {
  PLAYER
  BUSINESS
  INFLUENCER
  SUPERADMIN
  ADMIN
  MODERATOR
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  SESSION_REVOKED
  KOBAID_MINTED
  ACCOUNT_SWITCHED
  KOBAID_ISSUED_STAFF
  SHOP_CREATED
  SHOP_VERIFICATION_REQUESTED
  SHOP_VERIFIED
  PRODUCT_SUBMITTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  BID_PLACED
  AUCTION_SETTLED
  CHECKOUT_CREATED
  ORDER_PAID
  ORDER_REFUNDED
  ORDER_FULFILLED
  CONNECT_ONBOARDED
  GROUP_CREATED
  GROUP_JOINED
  GROUP_LEFT
  GROUP_MODERATED
  LFG_CREATED
  LFG_JOIN_REQUESTED
  LFG_SETTLED
  POST_CREATED
  STORY_CREATED
  CONTENT_REPORTED
  CONTENT_HIDDEN
  REPORT_RESOLVED
  CONVERSATION_STARTED
  MESSAGE_SENT
  VANISH_PURGED
  TRADE_CREATED
  TRADE_UPDATED
  SERVER_REGISTERED
  SERVER_RCON_UPDATED
  SERVER_SUBMITTED
  SERVER_VERIFIED
  SERVER_REJECTED
  SERVER_SUSPENDED
  SERVER_RESTORED
  SERVER_STATUS_POLL
  SERVER_INTEGRATION_CONNECTED
  SERVER_INTEGRATION_TESTED
  SERVER_CREDENTIAL_ROTATED
  SERVER_INTEGRATION_DISCONNECTED
  SERVER_CAPABILITY_CHANGED
  SERVER_CIRCUIT_OPENED
  PLUS_CHECKOUT_STARTED
  PLUS_CANCELLED
  PLUS_ACTIVATED
  PLUS_UPDATED
  PLUS_PAYMENT_FAILED
  PLUS_RECONCILED
  PLUS_GRANT_ISSUED
  COIN_LEDGER_POSTED
  AIDEN_JOB_CREATED
  AIDEN_JOB_CANCELLED
  AIDEN_JOB_COMPLETED
  AIDEN_ASSET_REVIEW_SUBMITTED
  AIDEN_ASSET_APPROVED
  AIDEN_ASSET_REJECTED
  DEV_PRODUCT_SUBMITTED
  DEV_PROFILE_CREATED
  DEV_PROFILE_UPDATED
  DEV_MEMBER_CHANGED
  DEV_APP_CREATED
  DEV_APP_SUSPENDED
  DEV_KEY_CREATED
  DEV_KEY_REVOKED
  DEV_KEY_ROTATED
  DEV_WEBHOOK_CREATED
  DEV_WEBHOOK_ROTATED
  DEV_PRODUCT_APPROVED
  DEV_PRODUCT_REJECTED
  DEV_PRODUCT_SUSPENDED
  DEV_VERSION_APPROVED
  DEV_PURCHASE_COMPLETED
  DEV_PURCHASE_REFUNDED
  DEV_PUBLISHER_VERIFIED
  REFERRAL_CODE_CREATED
  REFERRAL_CODE_REVOKED
  REFERRAL_ATTRIBUTED
  INFLUENCER_EARNING_ACCRUED
  INFLUENCER_EARNING_PAID
  INFLUENCER_EARNING_VOIDED
  SHOP_PROMO_UPDATED
  INFLUENCER_PAYOUT_ONBOARDED
  INFLUENCER_PROFILE_UPDATED
  INFLUENCER_VERIFIED
  INFLUENCER_SUSPENDED
  AFFILIATE_CAMPAIGN_CREATED
  AFFILIATE_CAMPAIGN_SUBMITTED
  AFFILIATE_CAMPAIGN_MODERATED
  CAMPAIGN_PARTICIPATION_CHANGED
  PROMO_CODE_CREATED
  PROMO_CODE_SUSPENDED
  PROMOTION_COMMISSION_CREATED
  PROMOTION_COMMISSION_REVERSED
  SPONSORED_CAMPAIGN_CREATED
  SPONSORED_CAMPAIGN_MODERATED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  profile        AccountProfile?
  kobaIdentities KobaIdentity[]
  auditLogs      AuditLog[]     @relation("AuditActor")
  products       Product[]
  favorites      ProductFavorite[]
  ownedShop      Shop?            @relation("ShopOwner")
  shopMemberships ShopMember[]
  shopFollows    ShopFollow[]
  shopReviews    ShopReview[]     @relation("ShopReviewAuthor")
  ordersBought   Order[]          @relation("OrderBuyer")
  bids           Bid[]
  wonAuctions    Auction[]        @relation("AuctionWinner")
  ownedGroups    Group[]          @relation("GroupOwner")
  groupMemberships GroupMember[]
  groupJoinRequests GroupJoinRequest[]
  groupInvitesSent GroupInvitation[] @relation("GroupInviteSender")
  groupInvitesReceived GroupInvitation[] @relation("GroupInvitee")
  groupBansIssued GroupBan[]      @relation("GroupBanActor")
  groupBans       GroupBan[]      @relation("GroupBanTarget")
  lfgPosts        LfgPost[]
  lfgRequests     LfgRequest[]
  posts           Post[]
  comments        PostComment[]
  reactions       PostReaction[]
  savedPosts      PostSave[]
  stories         Story[]
  storyViews      StoryView[]
  follows         UserFollow[]     @relation("Followers")
  following       UserFollow[]     @relation("Following")
  blocks          UserBlock[]      @relation("Blocker")
  blockedBy       UserBlock[]      @relation("Blocked")
  reports         ContentReport[]
  conversationMemberships ConversationParticipant[]
  directMessages  DirectMessage[]
  tradesProposed  TradeOffer[]      @relation("TradeProposer")
  tradesReceived  TradeOffer[]      @relation("TradeCounterparty")
  inventoryItems  InventoryItem[]
  tradeEvents     TradeEvent[]
  ownedServers    GameServer[]
  serverFavourites ServerFavourite[]
  serverNotices   ServerOwnerNotice[]
  plusSubscriptions PlusSubscription[]
  stripeCustomerId  String?            @unique
  coinWallet      CoinWallet?
  ledgerAccounts  LedgerAccount[]
  aidenJobs       AidenJob[]
  aidenAssets     AidenAsset[]
  ownedDeveloperProfiles DeveloperProfile[] @relation("DeveloperProfileOwner")
  developerMemberships DeveloperMember[]
  devProducts     DevProduct[]
  devInstalls     DevInstall[]
  devPurchases    DevPurchase[]
  devEntitlements DevEntitlement[]
  devReviews      DevProductReview[]
  developerApiKeys DeveloperApiKey[]
  referralCodes           ReferralCode[]            @relation("ReferralInfluencer")
  influencerEarnings      InfluencerEarning[]       @relation("InfluencerEarnings")
  influencerPayoutAccount InfluencerPayoutAccount?
  influencerProfile       InfluencerProfile?
  affiliateCampaigns      AffiliateCampaign[]       @relation("CampaignSeller")
  campaignParticipations  CampaignParticipation[]
  promoCodesCreated       PromoCode[]               @relation("PromoCodeSeller")
  promoRedemptions        PromoCodeRedemption[]
  promotionCommissionsEarned PromotionCommission[]  @relation("CommissionInfluencer")
  promotionCommissionsSold   PromotionCommission[]  @relation("CommissionSeller")
  sponsoredCampaigns      SponsoredCampaign[]
  promotionNotices        PromotionNotice[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum TagPrivacy {
  EVERYONE
  FOLLOWERS
  NO_ONE
}

model AccountProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  handle             String           @unique
  displayName        String?
  bio                String?
  activeAccountType  KobaAccountType  @default(PLAYER)
  tagPrivacy         TagPrivacy       @default(FOLLOWERS)
  kobaIdRevealedAt   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KobaIdentity {
  id          String          @id @default(cuid())
  code        String          @unique @db.VarChar(16)
  accountType KobaAccountType
  userId      String
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plusSubscription PlusSubscription?
  plusGrants       PlusEntitlementGrant[]
  aidenJobs        AidenJob[]
  developerProfiles DeveloperProfile[]

  @@unique([userId, accountType])
  @@index([code])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  action      AuditAction
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?     @db.VarChar(45)
  createdAt   DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

enum ProductRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  RELIC
}

enum ProductCategoryKind {
  SKINS
  MAPS
  MONUMENTS
  KITS
  COSMETICS
  SERVER_ASSETS
}

enum GamePlatform {
  PC
  STEAM
  XBOX
  PLAYSTATION
}

enum ModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ListingType {
  FIXED
  AUCTION
}

enum ProductMediaKind {
  IMAGE
  VIDEO
}

model Game {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  products  Product[]
  lfgPosts  LfgPost[]
}

model Category {
  id        String              @id @default(cuid())
  slug      String              @unique
  name      String
  kind      ProductCategoryKind
  createdAt DateTime            @default(now())
  products  Product[]
}

model Product {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  description        String           @db.Text
  rarity             ProductRarity
  rarityRank         Int
  listingType        ListingType      @default(FIXED)
  moderationStatus   ModerationStatus @default(DRAFT)
  priceCents         Int
  currency           String           @default("USD")
  inventoryQty       Int              @default(0)
  platforms          GamePlatform[]
  sellerUserId       String
  shopId             String?
  gameId             String
  categoryId         String
  publishedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  seller    User              @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)
  shop      Shop?             @relation(fields: [shopId], references: [id], onDelete: SetNull)
  game      Game              @relation(fields: [gameId], references: [id], onDelete: Restrict)
  category  Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants  ProductVariant[]
  media     ProductMedia[]
  favorites ProductFavorite[]
  orderItems      OrderItem[]
  auction         Auction?
  referralCodes   ReferralCode[]
  campaignProducts AffiliateCampaignProduct[]
  promoCodeProducts PromoCodeProduct[]

  @@index([moderationStatus, publishedAt])
  @@index([gameId])
  @@index([categoryId])
  @@index([rarity])
  @@index([sellerUserId])
  @@index([shopId])
  @@index([priceCents])
  @@index([rarityRank])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  sku          String   @unique
  name         String
  priceCents   Int?
  inventoryQty Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductMedia {
  id        String           @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int              @default(0)
  kind      ProductMediaKind @default(IMAGE)
  createdAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductFavorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

enum ShopVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ShopMemberRole {
  OWNER
  MODERATOR
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model Shop {
  id                   String                 @id @default(cuid())
  slug                 String                 @unique
  name                 String
  bio                  String                 @db.Text
  ownerUserId          String                 @unique
  verificationStatus   ShopVerificationStatus @default(UNVERIFIED)
  verificationNote     String?
  stripeAccountId      String?                @unique
  chargesEnabled       Boolean                @default(false)
  payoutsEnabled       Boolean                @default(false)
  taggingAllowed       Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  owner         User             @relation("ShopOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members       ShopMember[]
  follows       ShopFollow[]
  reviews       ShopReview[]
  products      Product[]
  orders        Order[]
  servers       GameServer[]
  promoConfig          ShopPromoConfig?
  referralCodes        ReferralCode[]
  affiliateCampaigns   AffiliateCampaign[]
  promoCodes           PromoCode[]
}

model ShopMember {
  shopId    String
  userId    String
  role      ShopMemberRole
  createdAt DateTime       @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shopId, userId])
  @@index([userId])
}

model ShopFollow {
  shopId    String
  userId    String
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shopId, userId])
  @@index([userId])
}

model ShopReview {
  id           String   @id @default(cuid())
  shopId       String
  authorUserId String
  rating       Int
  body         String   @db.Text
  createdAt    DateTime @default(now())

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  author User @relation("ShopReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([shopId, authorUserId])
  @@index([shopId])
}

enum OrderKind {
  FIXED
  AUCTION
}

model Order {
  id                      String      @id @default(cuid())
  publicRef               String      @unique
  shopId                  String
  buyerUserId             String
  status                  OrderStatus @default(PENDING)
  kind                    OrderKind   @default(FIXED)
  totalCents              Int
  applicationFeeCents     Int         @default(0)
  sellerPayoutCents       Int
  influencerShareCents    Int         @default(0)
  originalSubtotalCents   Int         @default(0)
  discountCents           Int         @default(0)
  eligibleCommissionBaseCents Int     @default(0)
  promoCodeId             String?
  campaignId              String?
  participationId         String?
  attributionSource       AttributionSource?
  currency                String      @default("USD")
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?
  idempotencyKey          String      @unique
  auctionId               String?
  paidAt                  DateTime?
  refundedAt              DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  referralCodeId String?

  shop                 Shop                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  buyer                User                  @relation("OrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  referralCode         ReferralCode?         @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  referralAttribution     ReferralAttribution?
  influencerEarning       InfluencerEarning?
  promoCode               PromoCode?             @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  campaign                AffiliateCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  participation           CampaignParticipation? @relation(fields: [participationId], references: [id], onDelete: SetNull)
  promotionCommission     PromotionCommission?
  promoRedemption         PromoCodeRedemption?

  @@index([shopId, createdAt])
  @@index([buyerUserId])
  @@index([status])
  @@index([referralCodeId])
  @@index([promoCodeId])
  @@index([campaignId])
}

model ProcessedStripeEvent {
  eventId      String   @id
  type         String
  eventCreated Int?
  createdAt    DateTime @default(now())
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  titleSnapshot  String
  quantity       Int
  unitPriceCents Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

enum PromoPayoutType {
  PERCENT_BPS
  FIXED_CENTS
}

enum InfluencerEarningStatus {
  ACCRUED
  PAYABLE
  PAID
  VOID
  HELD
}

model ShopPromoConfig {
  shopId             String          @id
  influencerEligible Boolean         @default(false)
  payoutType         PromoPayoutType @default(PERCENT_BPS)
  payoutValue        Int             @default(1000)
  updatedAt          DateTime        @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model ReferralCode {
  id               String    @id @default(cuid())
  publicRef        String    @unique
  code             String    @unique
  influencerUserId String
  productId        String
  shopId           String
  active           Boolean   @default(true)
  clickCount       Int       @default(0)
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  influencer   User                   @relation("ReferralInfluencer", fields: [influencerUserId], references: [id], onDelete: Cascade)
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop         Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders       Order[]
  attributions ReferralAttribution[]
  earnings     InfluencerEarning[]

  @@unique([influencerUserId, productId])
  @@index([shopId, active])
  @@index([productId, active])
}

model ReferralAttribution {
  id               String   @id @default(cuid())
  orderId          String   @unique
  referralCodeId   String
  influencerUserId String
  createdAt        DateTime @default(now())

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)

  @@index([referralCodeId])
  @@index([influencerUserId])
}

model InfluencerEarning {
  id               String                   @id @default(cuid())
  publicRef        String                   @unique
  influencerUserId String
  referralCodeId   String
  orderId          String                   @unique
  amountCents      Int
  currency         String                   @default("USD")
  status           InfluencerEarningStatus  @default(ACCRUED)
  stripeTransferId String?                  @unique
  createdAt        DateTime                 @default(now())
  paidAt           DateTime?
  voidedAt         DateTime?

  influencer   User         @relation("InfluencerEarnings", fields: [influencerUserId], references: [id], onDelete: Restrict)
  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([influencerUserId, createdAt])
  @@index([status])
}

model InfluencerPayoutAccount {
  userId           String   @id
  stripeAccountId  String?  @unique
  payoutsEnabled   Boolean  @default(false)
  detailsSubmitted Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum InfluencerVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum AffiliateCampaignStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
  SUSPENDED
  CANCELLED
}

enum CampaignParticipationStatus {
  INVITED
  APPLIED
  ACTIVE
  REJECTED
  PAUSED
  REVOKED
  COMPLETED
}

enum PromotionRateType {
  FIXED
  PERCENTAGE
}

enum AttributionSource {
  CLICK
  PROMO_CODE
}

enum PromotionCommissionStatus {
  PENDING
  QUALIFIED
  AVAILABLE
  REVERSED
  PAID
  CANCELLED
  UNDER_REVIEW
}

enum SponsoredEntityType {
  PRODUCT
  SHOP
  DEV_PRODUCT
  GAME_SERVER
}

enum SponsoredPlacement {
  MARKETPLACE
  SHOP
  APPS
  SERVERS
}

enum SponsoredCampaignStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
  SUSPENDED
  CANCELLED
}

enum SponsoredEventType {
  IMPRESSION
  CLICK
  SPEND
  RELEASE
}

model InfluencerProfile {
  id                    String                        @id @default(cuid())
  userId                String                        @unique
  slug                  String                        @unique
  displayName           String
  bio                   String                        @default("") @db.Text
  avatarUrl             String?
  bannerUrl             String?
  socialLinksJson       String                        @default("[]")
  games                 String[]
  categories            String[]
  audienceRegions       String[]
  contactEmail          String?
  verificationStatus    InfluencerVerificationStatus  @default(UNVERIFIED)
  verificationNote      String?
  suspendedAt           DateTime?
  payoutEligible        Boolean                       @default(false)
  disclosureAcceptedAt  DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
}

model AffiliateCampaign {
  id                      String                   @id @default(cuid())
  publicRef               String                   @unique
  shopId                  String
  sellerUserId            String
  name                    String
  status                  AffiliateCampaignStatus  @default(DRAFT)
  commissionType          PromotionRateType        @default(PERCENTAGE)
  commissionValue         Int                      @default(1000)
  discountType            PromotionRateType?
  discountValue           Int?
  attributionWindowHours  Int                      @default(168)
  totalBudgetCents        Int                      @default(0)
  remainingBudgetCents    Int                      @default(0)
  perInfluencerLimitCents Int?
  totalConversionLimit    Int?
  conversionCount         Int                      @default(0)
  targetGames             String[]
  targetCategories        String[]
  openApplications        Boolean                  @default(true)
  terms                   String                   @default("") @db.Text
  startsAt                DateTime?
  endsAt                  DateTime?
  moderationNote          String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  shop           Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  seller         User                      @relation("CampaignSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  products       AffiliateCampaignProduct[]
  participations CampaignParticipation[]
  promoCodes     PromoCode[]
  commissions    PromotionCommission[]
  orders         Order[]
  clickEvents    ReferralClickEvent[]

  @@index([shopId, status])
  @@index([sellerUserId, status])
}

model AffiliateCampaignProduct {
  campaignId String
  productId  String

  campaign AffiliateCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@index([productId])
}

model CampaignParticipation {
  id               String                       @id @default(cuid())
  publicRef        String                       @unique
  campaignId       String
  influencerUserId String
  status           CampaignParticipationStatus  @default(APPLIED)
  referralToken    String                       @unique
  promoCodeId      String?
  termsAcceptedAt  DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  campaign     AffiliateCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
