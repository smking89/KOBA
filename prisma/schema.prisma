generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KobaAccountType {
  PLAYER
  BUSINESS
  INFLUENCER
  SUPERADMIN
  ADMIN
  MODERATOR
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  SESSION_REVOKED
  KOBAID_MINTED
  ACCOUNT_SWITCHED
  KOBAID_ISSUED_STAFF
  SHOP_CREATED
  SHOP_VERIFICATION_REQUESTED
  SHOP_VERIFIED
  PRODUCT_SUBMITTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  BID_PLACED
  AUCTION_SETTLED
  CHECKOUT_CREATED
  ORDER_PAID
  ORDER_REFUNDED
  ORDER_FULFILLED
  ORDER_ESCROW_RELEASED
  ORDER_ESCROW_DISPUTED
  ORDER_ESCROW_DISPUTE_RESOLVED
  CONNECT_ONBOARDED
  GROUP_CREATED
  GROUP_JOINED
  GROUP_LEFT
  GROUP_MODERATED
  LFG_CREATED
  LFG_JOIN_REQUESTED
  LFG_SETTLED
  POST_CREATED
  STORY_CREATED
  CONTENT_REPORTED
  CONTENT_HIDDEN
  REPORT_RESOLVED
  CONVERSATION_STARTED
  MESSAGE_SENT
  VANISH_PURGED
  TRADE_CREATED
  TRADE_UPDATED
  SERVER_REGISTERED
  SERVER_RCON_UPDATED
  PLUS_CHECKOUT_STARTED
  PLUS_CANCELLED
  COIN_LEDGER_POSTED
  AIDEN_JOB_CREATED
  AIDEN_JOB_CANCELLED
  AIDEN_JOB_COMPLETED
  AIDEN_JOB_FAILED
  DEV_PRODUCT_SUBMITTED
  PLATFORM_FUNCTION_ENABLED
  PLATFORM_FUNCTION_DISABLED
  BOOST_PURCHASED
  BOOST_GIFTED
  BOOST_APPLIED
  AIDEN_ASSET_PUBLISHED
  PLUS_ACTIVATED
  SERVER_ACTIVE_MAP_SET
  FREEBIE_CLAIMED
  SERVER_KIT_DELIVERED
}

// Major, independently-toggleable platform functions. This is the registry
// key set for the superadmin "kill switch" panel — see
// features/platform-control/lib/functions.ts for the human-readable
// registry (label/description) that maps onto these keys, and
// docs/tdls.md for why this exists (TDLS trust-boundary enforcement,
// slice 1 of 3: superadmin function control).
enum PlatformFunctionKey {
  STRIPE_PAYMENTS
  AIDEN_GENERATION
  CLAUDE_DESCRIPTION_ASSIST
  SOCIAL_POSTING
  MESSAGING
  TRADE
  MARKETPLACE_CHECKOUT
  SERVER_RCON
  PLUS_SUBSCRIPTIONS
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  profile        AccountProfile?
  kobaIdentities KobaIdentity[]
  auditLogs      AuditLog[]     @relation("AuditActor")
  platformFunctionFlagUpdates PlatformFunctionFlag[] @relation("PlatformFunctionFlagUpdatedBy")
  boostsOwned    Boost[]        @relation("BoostOwner")
  boostsGifted   Boost[]        @relation("BoostGiftedFrom")
  products       Product[]
  favorites      ProductFavorite[]
  ownedShop      Shop?            @relation("ShopOwner")
  shopMemberships ShopMember[]
  shopFollows    ShopFollow[]
  shopReviews    ShopReview[]     @relation("ShopReviewAuthor")
  ordersBought   Order[]          @relation("OrderBuyer")
  coinPurchases  CoinPurchase[]
  escrowDisputesFiled    OrderEscrow[] @relation("OrderEscrowDisputedBy")
  escrowDisputesResolved OrderEscrow[] @relation("OrderEscrowResolvedBy")
  bids           Bid[]
  wonAuctions    Auction[]        @relation("AuctionWinner")
  ownedGroups    Group[]          @relation("GroupOwner")
  groupMemberships GroupMember[]
  groupJoinRequests GroupJoinRequest[]
  groupInvitesSent GroupInvitation[] @relation("GroupInviteSender")
  groupInvitesReceived GroupInvitation[] @relation("GroupInvitee")
  groupBansIssued GroupBan[]      @relation("GroupBanActor")
  groupBans       GroupBan[]      @relation("GroupBanTarget")
  lfgPosts        LfgPost[]
  lfgRequests     LfgRequest[]
  posts           Post[]
  comments        PostComment[]
  reactions       PostReaction[]
  savedPosts      PostSave[]
  stories         Story[]
  storyViews      StoryView[]
  follows         UserFollow[]     @relation("Followers")
  following       UserFollow[]     @relation("Following")
  blocks          UserBlock[]      @relation("Blocker")
  blockedBy       UserBlock[]      @relation("Blocked")
  reports         ContentReport[]
  conversationMemberships ConversationParticipant[]
  directMessages  DirectMessage[]
  tradesProposed  TradeOffer[]      @relation("TradeProposer")
  tradesReceived  TradeOffer[]      @relation("TradeCounterparty")
  inventoryItems  InventoryItem[]
  tradeEvents     TradeEvent[]
  ownedServers    GameServer[]
  plusSubscription PlusSubscription?
  serverBios       ServerBio[]
  freebieClaims    FreebieClaim[]
  coinWallet      CoinWallet?
  ledgerAccounts  LedgerAccount[]
  aidenJobs       AidenJob[]
  aidenAssets     AidenAsset[]
  devProducts     DevProduct[]
  devInstalls     DevInstall[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum TagPrivacy {
  EVERYONE
  FOLLOWERS
  NO_ONE
}

model AccountProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  handle             String           @unique
  displayName        String?
  bio                String?
  activeAccountType  KobaAccountType  @default(PLAYER)
  tagPrivacy         TagPrivacy       @default(FOLLOWERS)
  kobaIdRevealedAt   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KobaIdentity {
  id          String          @id @default(cuid())
  code        String          @unique @db.VarChar(16)
  accountType KobaAccountType
  userId      String
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountType])
  @@index([code])
}

// prevHash/hash form a tamper-evident hash chain: each row's hash commits to
// its own fields plus the previous row's hash, so editing or deleting a past
// entry breaks the chain from that point forward (detectable via
// verifyAuditChain() in audit-log.service.ts). Rows written before this
// chaining was added have null prevHash/hash — the chain is considered to
// start fresh at the first non-null row.
model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  action      AuditAction
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?     @db.VarChar(45)
  createdAt   DateTime    @default(now())
  prevHash    String?     @db.VarChar(64)
  hash        String?     @db.VarChar(64)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

// One row per PlatformFunctionKey. Absence of a row means "enabled" (the
// default, so shipping a new function doesn't require a migration to turn
// it on) — only an explicit row with enabled=false blocks the function.
// Runtime callers use isPlatformFunctionEnabled(), which fails CLOSED
// (treats the function as disabled) if the DB read itself errors, since
// this guards real money/API-cost paths and a silent bypass on DB outage
// would be worse than a false block.
model PlatformFunctionFlag {
  id              String              @id @default(cuid())
  key             PlatformFunctionKey @unique
  enabled         Boolean             @default(true)
  note            String?
  updatedByUserId String?
  updatedAt       DateTime            @updatedAt
  createdAt       DateTime            @default(now())

  updatedBy User? @relation("PlatformFunctionFlagUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([key])
}

// Boost target kind — deliberately extensible ("or any supported
// feature" per client direction). Adding a new boostable surface (e.g.
// LFG posts) is a new enum value + a new case in
// features/boost/services/boost.service.ts's ownership check, not a
// schema rewrite.
enum BoostTargetKind {
  PRODUCT
  SHOP
  GROUP
  SERVER
  INFLUENCER
}

enum BoostStatus {
  UNUSED
  APPLIED
  EXPIRED
}

// A Boost is a purchasable, held item (like Coins, it sits in the
// buyer's wallet until spent) rather than a live ad campaign. Fixed
// effect (see features/boost/lib/pricing.ts: 10 minutes, 3x exposure —
// both client-specified, not configurable per-purchase). Follows the
// AuditLog.targetType/targetId string-pair convention for its
// polymorphic target rather than three nullable FK columns, since this
// codebase already uses that pattern for exactly this kind of
// "one row can point at several different entity types" case.
model Boost {
  id                String           @id @default(cuid())
  ownerUserId       String
  status            BoostStatus      @default(UNUSED)
  purchaseCoinCost  Int
  purchasedAt       DateTime         @default(now())
  giftedFromUserId  String?
  giftedAt          DateTime?
  targetType        BoostTargetKind?
  targetId          String?
  appliedAt         DateTime?
  expiresAt         DateTime?
  idempotencyKey    String           @unique

  owner       User  @relation("BoostOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  giftedFrom  User? @relation("BoostGiftedFrom", fields: [giftedFromUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([targetType, targetId])
}

enum ProductRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  RELIC
}

enum ProductCategoryKind {
  SKINS
  MAPS
  MONUMENTS
  KITS
  COSMETICS
  SERVER_ASSETS
}

enum GamePlatform {
  PC
  STEAM
  XBOX
  PLAYSTATION
}

enum ModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ListingType {
  FIXED
  AUCTION
}

enum ProductMediaKind {
  IMAGE
  VIDEO
}

/// Per-game marketplace-content policy, derived from the ARK deep-dive +
/// per-title ToS sweep (2026-08-14). Desk research, not legal counsel — see
/// docs/game-content-policy.md. FULL = mods/maps/kits/skins all allowed.
/// SKINS_ONLY = only Category.kind = SKINS listings allowed (in-game
/// character/item skins — the actual thing publisher policies like
/// Minecraft's mean by "cosmetics/perks are the sanctioned path"; mods/
/// maps/kits are not). EXCLUDED = no listings of any kind — a sourced,
/// direct conflict with the publisher's stated policy. LEGAL_REVIEW = no
/// public policy found either direction; blocked pending actual legal
/// counsel or direct publisher contact, not desk-research clearance.
/// NOTE: Category.kind = COSMETICS and the separate Cosmetic model
/// (avatar decorations, profile effects, nameplates, profile frames, shop
/// banners, emojis — KOBA's own subscription-style profile/shop
/// customization) are never game-specific and are NEVER gated by this
/// policy at all.
enum GameContentPolicy {
  FULL
  SKINS_ONLY
  EXCLUDED
  LEGAL_REVIEW
}

model Game {
  id            String            @id @default(cuid())
  slug          String            @unique
  name          String
  contentPolicy GameContentPolicy @default(FULL)
  /// Human-readable citation for contentPolicy, shown to sellers/staff —
  /// e.g. "Wildcard's CurseForge moderation guidelines mandate Tebex-only
  /// payout for monetized mods; conflicts with KOBA's Stripe Connect
  /// architecture." Null only for FULL-policy games with nothing to cite.
  policyNote    String?
  createdAt     DateTime          @default(now())
  products      Product[]
  lfgPosts      LfgPost[]
}

model Category {
  id        String              @id @default(cuid())
  slug      String              @unique
  name      String
  kind      ProductCategoryKind
  createdAt DateTime            @default(now())
  products  Product[]
}

/// Freebie policy (ROADMAP.md Phase 18): NONE = normal paid listing.
/// PERMANENT = always free, no quantity limit. LIMITED_QUANTITY = free
/// for the first `freebieQuantityRemaining` claims, then reverts to
/// `priceCents` as a normal paid listing. Deliberately NOT a separate
/// $0-price convention (priceCents already allows 0) — freebiePolicy
/// disambiguates "genuinely free" from "a seller priced this at zero,"
/// which are different things (a $0 non-freebie product would still go
/// through paid checkout's Stripe flow, wastefully, for no money moved).
enum FreebiePolicy {
  NONE
  PERMANENT
  LIMITED_QUANTITY
}

model Product {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  description        String           @db.Text
  rarity             ProductRarity
  rarityRank         Int
  listingType        ListingType      @default(FIXED)
  moderationStatus   ModerationStatus @default(DRAFT)
  priceCents         Int
  currency           String           @default("USD")
  inventoryQty       Int              @default(0)
  platforms          GamePlatform[]
  sellerUserId       String
  shopId             String?
  gameId             String
  categoryId         String
  publishedAt        DateTime?
  freebiePolicy      FreebiePolicy    @default(NONE)
  /// Meaningful only when freebiePolicy = LIMITED_QUANTITY — a one-time
  /// lifetime pool per product (client direction not yet given on
  /// replenishment; "first 15 free" is modeled as never resetting,
  /// flagged in ROADMAP.md as the default, not a guess left unstated).
  /// Decrements independently of inventoryQty, which also decrements on
  /// a free claim (a free claim still consumes real stock).
  freebieQuantityRemaining Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  seller    User              @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)
  shop      Shop?             @relation(fields: [shopId], references: [id], onDelete: SetNull)
  game      Game              @relation(fields: [gameId], references: [id], onDelete: Restrict)
  category  Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants  ProductVariant[]
  media     ProductMedia[]
  favorites ProductFavorite[]
  orderItems OrderItem[]
  auction    Auction?
  aidenAsset AidenAsset?
  freebieClaims FreebieClaim[]

  @@index([moderationStatus, publishedAt])
  @@index([gameId])
  @@index([categoryId])
  @@index([rarity])
  @@index([sellerUserId])
  @@index([shopId])
  @@index([priceCents])
  @@index([rarityRank])
  @@index([freebiePolicy])
}

/// One row per successful free claim — enforces one-claim-per-buyer
/// (Order itself has no such constraint; multiple paid orders for the
/// same product are normal). Modeled on DevInstall's shape.
model FreebieClaim {
  id           String   @id @default(cuid())
  productId    String
  buyerUserId  String
  orderId      String   @unique
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([productId, buyerUserId])
  @@index([buyerUserId])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  sku          String   @unique
  name         String
  priceCents   Int?
  inventoryQty Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductMedia {
  id        String           @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int              @default(0)
  kind      ProductMediaKind @default(IMAGE)
  createdAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductFavorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

enum ShopVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ShopMemberRole {
  OWNER
  MODERATOR
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model Shop {
  id                   String                 @id @default(cuid())
  slug                 String                 @unique
  name                 String
  bio                  String                 @db.Text
  ownerUserId          String                 @unique
  verificationStatus   ShopVerificationStatus @default(UNVERIFIED)
  verificationNote     String?
  stripeAccountId      String?                @unique
  chargesEnabled       Boolean                @default(false)
  payoutsEnabled       Boolean                @default(false)
  taggingAllowed       Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  owner       User             @relation("ShopOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members     ShopMember[]
  follows     ShopFollow[]
  reviews     ShopReview[]
  products    Product[]
  orders      Order[]
  servers     GameServer[]
  cosmetics   Cosmetic[]
  promoConfig ShopPromoConfig?
}

model ShopMember {
  shopId    String
  userId    String
  role      ShopMemberRole
  createdAt DateTime       @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shopId, userId])
  @@index([userId])
}

model ShopFollow {
  shopId    String
  userId    String
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shopId, userId])
  @@index([userId])
}

model ShopReview {
  id           String   @id @default(cuid())
  shopId       String
  authorUserId String
  rating       Int
  body         String   @db.Text
  createdAt    DateTime @default(now())

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  author User @relation("ShopReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([shopId, authorUserId])
  @@index([shopId])
}

/// Universal KOBA identity/shop customization, purchased in USD (not KOBA
/// Coins) — the client's own framing (ROADMAP.md Phase 3: "sold
/// pre-made"; KOBA Plus/Phase 16 expands the same idea into a recurring
/// subscription). Never game-specific — a Cosmetic decorates a KOBA
/// profile or shop, not an in-game character, so it is never subject to
/// any single game's ToS and is deliberately NOT gated by
/// Game.contentPolicy (see features/marketplace/lib/game-policy.ts and
/// docs/game-content-policy.md).
enum CosmeticSubType {
  AVATAR_DECORATION
  PROFILE_EFFECT
  NAMEPLATE
  PROFILE_FRAME
  SHOP_BANNER
  EMOJI
}

/// Sold pre-made, closed sub-type enum, no custom-build fields, per
/// ROADMAP.md Phase 3's explicit non-goal.
model Cosmetic {
  id               String            @id @default(cuid())
  slug             String            @unique
  ownerShopId      String
  subType          CosmeticSubType
  rarity           ProductRarity
  name             String
  description      String            @db.Text
  priceCents       Int
  currency         String            @default("USD")
  moderationStatus ModerationStatus  @default(DRAFT)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  ownerShop Shop @relation(fields: [ownerShopId], references: [id], onDelete: Cascade)

  @@index([ownerShopId])
  @@index([moderationStatus])
  @@index([subType])
  @@index([rarity])
}

enum PromoPayoutType {
  PERCENT
  FIXED
}

/// Shop-side half of influencer eligibility/payout terms (ROADMAP.md Phase
/// 4/10). payoutValue is basis points (0-10000) for PERCENT, cents for
/// FIXED — see isValidPromoPayoutValue in features/shops/services/promo.service.ts.
model ShopPromoConfig {
  shopId             String           @id
  influencerEligible Boolean          @default(false)
  payoutType         PromoPayoutType  @default(PERCENT)
  payoutValue        Int              @default(0)
  updatedAt          DateTime         @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

enum OrderKind {
  FIXED
  AUCTION
}

model Order {
  id                      String      @id @default(cuid())
  publicRef               String      @unique
  shopId                  String
  buyerUserId             String
  status                  OrderStatus @default(PENDING)
  kind                    OrderKind   @default(FIXED)
  totalCents              Int
  applicationFeeCents     Int         @default(0)
  sellerPayoutCents       Int
  currency                String      @default("USD")
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?
  idempotencyKey          String      @unique
  auctionId               String?
  paidAt                  DateTime?
  refundedAt              DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  shop   Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  buyer  User         @relation("OrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  items  OrderItem[]
  escrow OrderEscrow?
  freebieClaim FreebieClaim?

  @@index([shopId, createdAt])
  @@index([buyerUserId])
  @@index([status])
}

enum EscrowStatus {
  HOLDING
  DISPUTED
  RELEASED
  REFUNDED
}

/// Holds the seller's payout on the platform's own Stripe balance for a short
/// window after payment. Auto-releases (transfer to the seller's Connect
/// account) once `releaseAt` passes, unless the buyer flags a dispute first.
/// Deliberately kept as a sibling table to `Order` — `Order.status` keeps its
/// existing meaning and existing code paths reading it are unaffected.
model OrderEscrow {
  id               String       @id @default(cuid())
  orderId          String       @unique
  status           EscrowStatus @default(HOLDING)
  releaseAt        DateTime
  disputedAt       DateTime?
  disputeReason    String?      @db.Text
  disputedByUserId String?
  resolvedAt       DateTime?
  resolvedByUserId String?
  stripeTransferId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  disputedBy User? @relation("OrderEscrowDisputedBy", fields: [disputedByUserId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("OrderEscrowResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([status, releaseAt])
}

model ProcessedStripeEvent {
  eventId   String   @id
  type      String
  createdAt DateTime @default(now())
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  titleSnapshot  String
  quantity       Int
  unitPriceCents Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  RESERVED
  CANCELLED
}

enum BidStatus {
  ACTIVE
  OUTBID
  WON
  VOID
}

model Auction {
  id                String        @id @default(cuid())
  productId         String        @unique
  status            AuctionStatus @default(SCHEDULED)
  startingBidCents  Int
  minIncrementCents Int
  highBidCents      Int?
  bidCount          Int           @default(0)
  startsAt          DateTime
  endsAt            DateTime
  winnerUserId      String?
  reservedUntil     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  winner  User?   @relation("AuctionWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  bids    Bid[]

  @@index([status, endsAt])
  @@index([winnerUserId])
}

model Bid {
  id             String    @id @default(cuid())
  auctionId      String
  bidderUserId   String
  amountCents    Int
  status         BidStatus @default(ACTIVE)
  idempotencyKey String    @unique
