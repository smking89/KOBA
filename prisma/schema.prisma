enum ShopVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ShopMemberRole {
  OWNER
  MODERATOR
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

/// Direct-RCON auto-delivery outcome, set the instant an order with an
/// rconKitName product is marked PAID (markOrderPaid) — not a manual
/// seller "fulfill" action.
/// Client, 2026-08-18 (KOBA-vs-Tip4Serv architecture spec): "the KOBA
/// gateway must cache the commands in a database queue and safely
/// retry execution using an exponential backoff strategy until success
/// is confirmed" for an offline/laggy target server — RETRYING covers
/// that in-flight state, DEAD is reached once RconCommandJob exhausts
/// its retry budget (RCON_JOB_MAX_ATTEMPTS). FAILED stays reserved for
/// non-retryable config problems (bad RCON credentials, unsupported
/// game) that a retry loop can't fix — only the seller can, by
/// correcting the server config and hitting retry. Both FAILED and DEAD
/// are seller-retryable (POST /api/business/orders/[publicRef]/redeliver).
enum RconDeliveryStatus {
  NOT_APPLICABLE
  PENDING
  RETRYING
  DELIVERED
  FAILED
  DEAD
}

/// Lifecycle of one queued RconCommandJob attempt. PENDING jobs with
/// runAfter <= now are claimed by the RCON delivery worker
/// (scripts/run-rcon-delivery-worker.mjs); after a transient failure
/// (server offline/timed out) the same job is put back to PENDING with
/// runAfter pushed out by computeRconBackoffMs, up to
/// RCON_JOB_MAX_ATTEMPTS before going DEAD.
enum RconCommandJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

model Shop {
  id                 String                 @id @default(cuid())
  slug               String                 @unique
  name               String
  bio                String                 @db.Text
  ownerUserId        String                 @unique
  verificationStatus ShopVerificationStatus @default(UNVERIFIED)
  verificationNote   String?
  stripeAccountId    String?                @unique
  chargesEnabled     Boolean                @default(false)
  payoutsEnabled     Boolean                @default(false)
  taggingAllowed     Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  owner                User                    @relation("ShopOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members              ShopMember[]
  follows              ShopFollow[]
  reviews              ShopReview[]
  products             Product[]
  orders               Order[]
  servers              GameServer[]
  cosmetics            Cosmetic[]
  promoConfig          ShopPromoConfig?
  referralCodes        ReferralCode[]
  affiliateCampaigns   AffiliateCampaign[]
  promoCodes           PromoCode[]
  socialConnections    ShopSocialConnection[]
  blacklistEntries     ShopBlacklistEntry[]
  platformBan          PlatformBlacklistEntry? @relation("PlatformBlacklistTargetShop")
  kobaShopApplication  KobaShopApplication?
  cosmeticOrders       CosmeticOrder[]
  productSubscriptions ProductSubscription[]
  shopCosmeticEquip    ShopCosmeticEquip?
}

model ShopMember {
  shopId    String
  userId    String
  role      ShopMemberRole
  createdAt DateTime       @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shopId, userId])
  @@index([userId])
}

model ShopFollow {
  shopId    String
  userId    String
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shopId, userId])
  @@index([userId])
}

model ShopReview {
  id           String   @id @default(cuid())
  shopId       String
  authorUserId String
  rating       Int
  body         String   @db.Text
  createdAt    DateTime @default(now())

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  author User @relation("ShopReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([shopId, authorUserId])
  @@index([shopId])
}

/// Universal KOBA identity/shop customization, purchased in USD (not KOBA
/// Coins) — the client's own framing (ROADMAP.md Phase 3: "sold
/// pre-made"; KOBA Plus/Phase 16 expands the same idea into a recurring
/// subscription). Never game-specific — a Cosmetic decorates a KOBA
/// profile or shop, not an in-game character, so it is never subject to
/// any single game's ToS and is deliberately NOT gated by
/// Game.contentPolicy (see features/marketplace/lib/game-policy.ts and
/// docs/game-content-policy.md).
enum CosmeticSubType {
  AVATAR_DECORATION
  PROFILE_EFFECT
  NAMEPLATE
  PROFILE_FRAME
  SHOP_BANNER
  EMOJI
}

/// Sold pre-made, closed sub-type enum, no custom-build fields, per
/// ROADMAP.md Phase 3's explicit non-goal.
model Cosmetic {
  id               String           @id @default(cuid())
  slug             String           @unique
  ownerShopId      String
  subType          CosmeticSubType
  rarity           ProductRarity
  name             String
  description      String           @db.Text
  priceCents       Int
  currency         String           @default("USD")
  moderationStatus ModerationStatus @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  ownerShop  Shop                @relation(fields: [ownerShopId], references: [id], onDelete: Cascade)
  orders     CosmeticOrder[]
  ownerships CosmeticOwnership[]

  @@index([ownerShopId])
  @@index([moderationStatus])
  @@index([subType])
  @@index([rarity])
}

/// Phase 23 — KOBA Shop (client, 2026-08-18): a second, narrower
/// application-gate on top of Blue-Badge shop verification (Phase 9) —
/// a shop can be Blue-Badge verified and still not be approved to sell
/// in the KOBA Shop specifically. Reuses the Blue-Badge admin review
/// pattern (confirmed via AskUserQuestion) rather than a separate
/// workflow — same PendingShopsPanel-style queue, same staff
/// permissions.
enum KobaShopApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model KobaShopApplication {
  id               String                    @id @default(cuid())
  shopId           String                    @unique
  status           KobaShopApplicationStatus @default(PENDING)
  note             String?                   @db.Text
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  shop       Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)
}

/// Cosmetic checkout — a dedicated model rather than reusing Order/
/// OrderItem (confirmed via AskUserQuestion): Cosmetic has no rarity-tier
/// inventory and no per-game shape, so a shared Order table would mean
/// permanently-null columns and branching logic everywhere Order is
/// already read (refunds, escrow, receipts). Settles as a direct Stripe
/// Connect destination charge at purchase time (no escrow hold, unlike
/// Product orders) — a digital cosmetic has none of the delivery-dispute
/// risk that motivated Product's escrow window.
model CosmeticOrder {
  id                      String      @id @default(cuid())
  publicRef               String      @unique
  idempotencyKey          String      @unique
  cosmeticId              String
  shopId                  String
  buyerUserId             String
  status                  OrderStatus @default(PENDING)
  unitPriceCents          Int
  applicationFeeCents     Int
  sellerPayoutCents       Int
  currency                String      @default("USD")
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  cosmetic  Cosmetic           @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)
  shop      Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  buyer     User               @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  ownership CosmeticOwnership?

  @@index([shopId])
  @@index([buyerUserId])
  @@index([cosmeticId])
}

/// Anyone can buy a cosmetic (client, 2026-08-18) — owning one and
/// being allowed to *equip* it are separate facts, tracked separately
/// (see CosmeticEquip) so a lapsed KOBA Plus subscription can hide an
/// equipped cosmetic without touching ownership at all.
model CosmeticOwnership {
  id         String   @id @default(cuid())
  userId     String
  cosmeticId String
  orderId    String   @unique
  acquiredAt DateTime @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic      Cosmetic           @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)
  order         CosmeticOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  personalEquip CosmeticEquip?
  shopEquip     ShopCosmeticEquip?

  @@unique([userId, cosmeticId])
  @@index([userId])
}

/// One active cosmetic per subtype per user (client, 2026-08-18,
/// confirmed via AskUserQuestion) — equipping requires KOBA Plus, but
/// this row is never deleted just because Plus lapses; visibility is
/// computed at read time from current Plus status
/// (features/koba-shop/services/cosmetic-equip.service.ts), so it
/// reappears automatically the moment Plus resumes rather than needing
/// re-equipping. SHOP_BANNER is deliberately excluded here (app-level,
/// not DB-level) — it equips onto a Shop, see ShopCosmeticEquip.
model CosmeticEquip {
  id                  String          @id @default(cuid())
  userId              String
  subType             CosmeticSubType
  cosmeticOwnershipId String          @unique
  equippedAt          DateTime        @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownership CosmeticOwnership @relation(fields: [cosmeticOwnershipId], references: [id], onDelete: Cascade)

  @@unique([userId, subType])
}

/// SHOP_BANNER's equip target is the Shop, not the buyer's own profile —
/// still gated on the shop owner (whoever bought it) holding active
/// KOBA Plus, same as CosmeticEquip.
model ShopCosmeticEquip {
  id                  String   @id @default(cuid())
  shopId              String   @unique
  cosmeticOwnershipId String   @unique
  equippedAt          DateTime @default(now())

  shop      Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ownership CosmeticOwnership @relation(fields: [cosmeticOwnershipId], references: [id], onDelete: Cascade)
}

enum OrderKind {
  FIXED
  AUCTION
}

model Order {
  id                          String             @id @default(cuid())
  publicRef                   String             @unique
  shopId                      String
  buyerUserId                 String
  status                      OrderStatus        @default(PENDING)
  kind                        OrderKind          @default(FIXED)
  totalCents                  Int
  applicationFeeCents         Int                @default(0)
  sellerPayoutCents           Int
  influencerShareCents        Int                @default(0)
  originalSubtotalCents       Int                @default(0)
  discountCents               Int                @default(0)
  eligibleCommissionBaseCents Int                @default(0)
  promoCodeId                 String?
  campaignId                  String?
  participationId             String?
  attributionSource           AttributionSource?
  currency                    String             @default("USD")
  stripeCheckoutSessionId     String?            @unique
  stripePaymentIntentId       String?
  idempotencyKey              String             @unique
  auctionId                   String?
  paidAt                      DateTime?
  refundedAt                  DateTime?
  /// Captured at checkout only when the purchased Product has
  /// rconKitName set — the in-game identifier (Steam persona, Xbox
  /// gamertag, PSN username; the `kit givetoplayer` command takes
  /// whatever string the game itself uses, see kit-commands.ts) the
  /// auto-delivery command targets. Resolved server-side at checkout
  /// from the buyer's pre-linked Steam/Xbox/PSN identity in Settings
  /// (features/game-identity#resolveGameHandleForPlatforms) — not
  /// typed in at checkout.
  buyerGameHandle             String?
  rconDeliveryStatus          RconDeliveryStatus @default(NOT_APPLICABLE)
  rconDeliveryError           String?            @db.Text
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  referralCodeId String?

  shop                Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  buyer               User                   @relation("OrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  referralCode        ReferralCode?          @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  referralAttribution ReferralAttribution?
  influencerEarning   InfluencerEarning?
  promoCode           PromoCode?             @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  campaign            AffiliateCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  participation       CampaignParticipation? @relation(fields: [participationId], references: [id], onDelete: SetNull)
  promotionCommission PromotionCommission?
  promoRedemption     PromoCodeRedemption?
  escrow              OrderEscrow?
  freebieClaim        FreebieClaim?
  rconCommandJobs     RconCommandJob[]

  @@index([shopId, createdAt])
  @@index([buyerUserId])
  @@index([status])
  @@index([referralCodeId])
  @@index([promoCodeId])
  @@index([campaignId])
}

enum EscrowStatus {
  HOLDING
  DISPUTED
  RELEASED
  REFUNDED
}

/// Holds the seller's payout on the platform's own Stripe balance for a short
/// window after payment. Auto-releases (transfer to the seller's Connect
/// account) once `releaseAt` passes, unless the buyer flags a dispute first.
/// Deliberately kept as a sibling table to `Order` — `Order.status` keeps its
/// existing meaning and existing code paths reading it are unaffected.
model OrderEscrow {
  id               String       @id @default(cuid())
  orderId          String       @unique
  status           EscrowStatus @default(HOLDING)
  releaseAt        DateTime
  disputedAt       DateTime?
  disputeReason    String?      @db.Text
  disputedByUserId String?
  resolvedAt       DateTime?
  resolvedByUserId String?
  stripeTransferId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  disputedBy User? @relation("OrderEscrowDisputedBy", fields: [disputedByUserId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("OrderEscrowResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([status, releaseAt])
}

model ProcessedStripeEvent {
  eventId      String   @id
  type         String
  eventCreated Int?
  createdAt    DateTime @default(now())
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  titleSnapshot  String
  quantity       Int
  unitPriceCents Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

enum PromoPayoutType {
  PERCENT_BPS
  FIXED_CENTS
}

enum InfluencerEarningStatus {
  ACCRUED
  PAYABLE
  PAID
  VOID
  HELD
}

model ShopPromoConfig {
