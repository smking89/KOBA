// A row exists per-user from their first visit to /plus (ensureSubscription
// upserts eagerly, state NONE) — so `createdAt` is NOT a tenure anchor,
// it's "first time this page was loaded." `firstActivatedAt` is the real
// tenure clock: set once, the first time state transitions to ACTIVE, and
// never touched again (a lapse-and-resubscribe does not reset it — see
// features/plus/lib/tenure.ts for why that's the deliberate choice, not
// an oversight).
model PlusSubscription {
  id                      String                @id @default(cuid())
  publicRef               String                @unique
  userId                  String
  kobaIdentityId          String                @unique
  accountType             KobaAccountType
  planId                  String?
  interval                PlusPlanInterval?
  provider                String                @default("stripe")
  stripeCustomerId        String?
  stripeSubscriptionId    String?               @unique
  stripeCheckoutSessionId String?               @unique
  checkoutIdempotencyKey  String?               @unique
  state                   PlusSubscriptionState @default(NONE)
  cancelAtPeriodEnd       Boolean               @default(false)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelledAt             DateTime?
  endedAt                 DateTime?
  trialEndsAt             DateTime?
  lastStripeEventId       String?
  lastStripeEventCreated  Int?
  version                 Int                   @default(0)
  firstActivatedAt        DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity KobaIdentity      @relation(fields: [kobaIdentityId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, accountType])
  @@index([state])
  @@index([stripeCustomerId])
}

