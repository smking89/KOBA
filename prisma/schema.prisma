model GameServer {
  id                       String                   @id @default(cuid())
  publicRef                String                   @unique
  slug                     String                   @unique
  name                     String
  description              String?                  @db.Text
  game                     String
  platformFamily           ServerPlatformFamily
  region                   String
  country                  String?
  timezone                 String?
  tags                     String[]
  ownerUserId              String
  /// Active KOBA account type that owns this server (BUSINESS or INFLUENCER).
  ownerAccountType         KobaAccountType
  shopId                   String?
  joinInfo                 String?
  hostname                 String?
  host                     String?
  queryPort                Int?
  gamePort                 Int?
  port                     Int?
  hideResolvedIp           Boolean                  @default(true)
  adapterKey               String                   @default("manual")
  capabilities             ServerCapability[]
  /// Client, 2026-08-18 (KOBA-vs-Tip4Serv architecture spec, Method B):
  /// "A secure, authenticated API endpoint hosted by KOBA that handles
  /// incoming requests from game server plugins... for modded servers."
  /// RCON = KOBA dials out to the server directly (existing channel).
  /// PLUGIN_API = the reverse: KOBA never touches this server's RCON at
  /// all, an Oxide/Spigot-style plugin polls KOBA's gateway for
  /// pending commands using its own ServerApiKey, matching how game
  /// servers behind NAT/firewalls actually reach out (they can't
  /// accept inbound connections, so pull beats push here).
  deliveryMethod           DeliveryMethod           @default(RCON)
  verificationStatus       ServerVerificationStatus @default(UNVERIFIED)
  publicationStatus        ServerPublicationStatus  @default(DRAFT)
  operationalStatus        ServerOnlineStatus       @default(UNKNOWN)
  /// Prefer operationalStatus; kept for expansion UI compatibility.
  status                   ServerOnlineStatus       @default(UNKNOWN)
  verificationToken        String?
  verificationNote         String?
  verifiedAt               DateTime?
  submittedAt              DateTime?
  suspendedAt              DateTime?
  livePlayers              Int?
  maxPlayers               Int?
  queue                    Int?
  mapName                  String?
  mapSize                  String?
  pingMs                   Int?
  lastRefreshAt            DateTime?
  lastSuccessfulAt         DateTime?
  freshUntil               DateTime?
  pollFailures             Int                      @default(0)
  nextPollAt               DateTime?
  rconTestState            RconTestState            @default(IDLE)
  /// "Rarity" for a server (client clarification, 2026-08-15): derived
  /// from a Map they own on this server, purchased on the KOBA
  /// marketplace — NOT a standalone server-level tier the owner just
  /// sets. Nullable: a server with no active map has no rarity to show.
  /// Must reference an InventoryItem the server's owner actually owns
  /// (features/servers/services/server.service.ts#setActiveMap
  /// enforces this — schema alone can't express "owned by the same
  /// user as ownerUserId").
  activeMapInventoryItemId String?                  @unique
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  owner                  User                     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  shop                   Shop?                    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  credential             ServerCredential?
  apiKey                 ServerApiKey?
  favourites             ServerFavourite[]
  snapshots              ServerStatusSnapshot[]
  integrations           ServerIntegration[]
  attempts               IntegrationAttempt[]
  jobs                   ServerIntegrationJob[]
  notices                ServerOwnerNotice[]
  idempotency            IntegrationIdempotency[]
  bios                   ServerBio[]
  activeMapInventoryItem InventoryItem?           @relation(fields: [activeMapInventoryItemId], references: [id], onDelete: SetNull)
  rconDeliveryProducts   Product[]                @relation("ProductRconServer")
  rconCommandJobs        RconCommandJob[]         @relation("RconCommandJobServer")
  productSubscriptions   ProductSubscription[]    @relation("ProductSubscriptionServer")

  @@index([ownerUserId])
  @@index([game, region])
  @@index([platformFamily])
  @@index([publicationStatus, verificationStatus])
  @@index([operationalStatus, nextPollAt])
  @@index([slug])
}

