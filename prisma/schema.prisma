model InventoryItem {
  id                 String                     @id @default(cuid())
  publicRef          String                     @unique
  ownerUserId        String
  title              String
  game               String
  platform           GamePlatform
  rarity             ProductRarity
  transferable       Boolean                    @default(false)
  listedForTrade     Boolean                    @default(false)
  status             InventoryItemStatus        @default(ACTIVE)
  acquisitionSource  InventoryAcquisitionSource @default(GRANT)
  productId          String?
  aidenAssetId       String?
  serial             String?
  lockTradeOfferId   String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  owner          User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  lockTradeOffer TradeOffer?      @relation("TradeItemLocks", fields: [lockTradeOfferId], references: [id], onDelete: SetNull)
  tradeLines     TradeOfferItem[]

  @@index([ownerUserId, listedForTrade, status])
  @@index([rarity, game])
  @@index([lockTradeOfferId])
  @@index([productId])
}

model TradeOffer {
  id                 String     @id @default(cuid())
  publicRef          String     @unique
  idempotencyKey     String     @unique
  state              TradeState @default(PENDING)
  rarityTier         ProductRarity
  proposerUserId     String
  counterpartyUserId String
  note               String?
  expiresAt          DateTime?
  version            Int        @default(0)
  parentTradeId      String?
  acceptedAt         DateTime?
  completedAt        DateTime?
  rejectedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  proposer     User             @relation("TradeProposer", fields: [proposerUserId], references: [id], onDelete: Cascade)
  counterparty User             @relation("TradeCounterparty", fields: [counterpartyUserId], references: [id], onDelete: Cascade)
  parentTrade  TradeOffer?      @relation("TradeCounterChain", fields: [parentTradeId], references: [id], onDelete: SetNull)
  childTrades  TradeOffer[]     @relation("TradeCounterChain")
  items        TradeOfferItem[]
  events       TradeEvent[]
  lockedItems  InventoryItem[]  @relation("TradeItemLocks")

  @@index([proposerUserId, createdAt])
  @@index([counterpartyUserId, createdAt])
  @@index([state, expiresAt])
  @@index([parentTradeId])
}

model TradeOfferItem {
  id               String         @id @default(cuid())
  tradeOfferId     String
  inventoryItemId  String
  side             TradeItemSide
  titleSnapshot    String
  gameSnapshot     String
  platformSnapshot GamePlatform
  raritySnapshot   ProductRarity
  ownerUserIdSnap  String
  createdAt        DateTime       @default(now())

  tradeOffer    TradeOffer    @relation(fields: [tradeOfferId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([tradeOfferId, inventoryItemId])
  @@index([tradeOfferId, side])
  @@index([inventoryItemId])
}

model TradeEvent {
  id           String         @id @default(cuid())
  tradeOfferId String
  actorUserId  String?
  type         TradeEventType
  fromState    TradeState?
  toState      TradeState?
  metadataJson String?
  createdAt    DateTime       @default(now())

  tradeOffer TradeOffer @relation(fields: [tradeOfferId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tradeOfferId, createdAt])
}

model GameServer {
  id                 String                   @id @default(cuid())
  publicRef          String                   @unique
  slug               String                   @unique
  name               String
  description        String?                  @db.Text
  game               String
  platformFamily     ServerPlatformFamily
  region             String
  country            String?
  timezone           String?
  tags               String[]
  ownerUserId        String
  /// Active KOBA account type that owns this server (BUSINESS or INFLUENCER).
  ownerAccountType   KobaAccountType
  shopId             String?
  joinInfo           String?
  hostname           String?
  host               String?
  queryPort          Int?
  gamePort           Int?
  port               Int?
  hideResolvedIp     Boolean                  @default(true)
  adapterKey         String                   @default("manual")
  capabilities       ServerCapability[]
  verificationStatus ServerVerificationStatus @default(UNVERIFIED)
  publicationStatus  ServerPublicationStatus  @default(DRAFT)
  operationalStatus  ServerOnlineStatus       @default(UNKNOWN)
  /// Prefer operationalStatus; kept for expansion UI compatibility.
  status             ServerOnlineStatus       @default(UNKNOWN)
  verificationToken  String?
  verificationNote   String?
  verifiedAt         DateTime?
  submittedAt        DateTime?
  suspendedAt        DateTime?
  livePlayers        Int?
  maxPlayers         Int?
  queue              Int?
  mapName            String?
  mapSize            String?
  pingMs             Int?
  lastRefreshAt      DateTime?
  lastSuccessfulAt   DateTime?
  freshUntil         DateTime?
  pollFailures       Int                      @default(0)
  nextPollAt         DateTime?
  rconTestState      RconTestState            @default(IDLE)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  owner        User                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  shop         Shop?                   @relation(fields: [shopId], references: [id], onDelete: SetNull)
  credential   ServerCredential?
  favourites   ServerFavourite[]
  snapshots    ServerStatusSnapshot[]
  integrations ServerIntegration[]
  attempts     IntegrationAttempt[]
  jobs         ServerIntegrationJob[]
  notices      ServerOwnerNotice[]
  idempotency  IntegrationIdempotency[]

  @@index([ownerUserId])
  @@index([game, region])
  @@index([platformFamily])
  @@index([publicationStatus, verificationStatus])
  @@index([operationalStatus, nextPollAt])
  @@index([slug])
}

model ServerStatusSnapshot {
  id               String             @id @default(cuid())
  serverId         String
  operationalState ServerOnlineStatus
  livePlayers      Int?
  maxPlayers       Int?
  queue            Int?
  mapName          String?
  mapSize          String?
  pingMs           Int?
  adapterKey       String
  checkedAt        DateTime           @default(now())
  successfulAt     DateTime?
  freshUntil       DateTime?
  errorCategory    String?
  createdAt        DateTime           @default(now())

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, checkedAt])
  @@index([checkedAt])
}

model ServerFavourite {
  userId    String
  serverId  String
  createdAt DateTime @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([userId, serverId])
  @@index([serverId])
}

model ServerCredential {
  id            String    @id @default(cuid())
  serverId      String    @unique
  integrationId String?   @unique
  ciphertext    String    @db.Text
  iv            String
  authTag       String
  keyVersion    Int       @default(1)
  revokedAt     DateTime?
  rotatedAt     DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  server      GameServer         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  integration ServerIntegration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model ServerIntegration {
  id                  String                    @id @default(cuid())
  serverId            String
  provider            ServerIntegrationProvider
  adapterKey          String
  mode                ServerIntegrationMode     @default(RCON_READ)
  status              ServerIntegrationStatus   @default(PENDING)
  hostname            String?
  queryPort           Int?
  rconPort            Int?
  keyVersion          Int                       @default(1)
  lastHealthJson      String?                   @db.Text
  lastTestedAt        DateTime?
  lastSuccessfulAt    DateTime?
  lastFailureCategory String?
  pollFailures        Int                       @default(0)
  nextPollAt          DateTime?
  circuitOpenedAt     DateTime?
  revokedAt           DateTime?
  disconnectedAt      DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  server     GameServer             @relation(fields: [serverId], references: [id], onDelete: Cascade)
  credential ServerCredential?
  attempts   IntegrationAttempt[]
  jobs       ServerIntegrationJob[]

  @@unique([serverId, provider])
  @@index([status, nextPollAt])
  @@index([serverId])
}

model IntegrationAttempt {
  id             String   @id @default(cuid())
  serverId       String
  integrationId  String?
  attemptType    String
  success        Boolean
  errorCategory  String?
  durationMs     Int
  correlationId  String
  idempotencyKey String?
  createdAt      DateTime @default(now())

  server      GameServer         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  integration ServerIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([serverId, createdAt])
  @@index([integrationId, createdAt])
  @@index([correlationId])
}

model ServerIntegrationJob {
  id                String    @id @default(cuid())
