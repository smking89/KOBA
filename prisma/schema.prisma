generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KobaAccountType {
  PLAYER
  BUSINESS
  INFLUENCER
  SUPERADMIN
  ADMIN
  MODERATOR
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  SESSION_REVOKED
  KOBAID_MINTED
  ACCOUNT_SWITCHED
  KOBAID_ISSUED_STAFF
  SHOP_CREATED
  SHOP_VERIFICATION_REQUESTED
  SHOP_VERIFIED
  PRODUCT_SUBMITTED
  PRODUCT_APPROVED
  BID_PLACED
  AUCTION_SETTLED
  CHECKOUT_CREATED
  ORDER_PAID
  ORDER_REFUNDED
  ORDER_FULFILLED
  CONNECT_ONBOARDED
  GROUP_CREATED
  GROUP_JOINED
  GROUP_LEFT
  GROUP_MODERATED
  LFG_CREATED
  LFG_JOIN_REQUESTED
  LFG_SETTLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  profile        AccountProfile?
  kobaIdentities KobaIdentity[]
  auditLogs      AuditLog[]     @relation("AuditActor")
  products       Product[]
  favorites      ProductFavorite[]
  ownedShop      Shop?            @relation("ShopOwner")
  shopMemberships ShopMember[]
  shopFollows    ShopFollow[]
  shopReviews    ShopReview[]     @relation("ShopReviewAuthor")
  ordersBought   Order[]          @relation("OrderBuyer")
  bids           Bid[]
  wonAuctions    Auction[]        @relation("AuctionWinner")
  ownedGroups    Group[]          @relation("GroupOwner")
  groupMemberships GroupMember[]
  groupJoinRequests GroupJoinRequest[]
  groupInvitesSent GroupInvitation[] @relation("GroupInviteSender")
  groupInvitesReceived GroupInvitation[] @relation("GroupInvitee")
  groupBansIssued GroupBan[]      @relation("GroupBanActor")
  groupBans       GroupBan[]      @relation("GroupBanTarget")
  lfgPosts        LfgPost[]
  lfgRequests     LfgRequest[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AccountProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  displayName        String?
  activeAccountType  KobaAccountType  @default(PLAYER)
  kobaIdRevealedAt   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KobaIdentity {
  id          String          @id @default(cuid())
  code        String          @unique @db.VarChar(16)
  accountType KobaAccountType
  userId      String
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountType])
  @@index([code])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  action      AuditAction
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?     @db.VarChar(45)
  createdAt   DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

enum ProductRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  RELIC
}

enum ProductCategoryKind {
  SKINS
  MAPS
  MONUMENTS
  KITS
  COSMETICS
  SERVER_ASSETS
}

enum GamePlatform {
  PC
  STEAM
  XBOX
  PLAYSTATION
}

enum ModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ListingType {
  FIXED
  AUCTION
}

enum ProductMediaKind {
  IMAGE
  VIDEO
}

model Game {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  products  Product[]
  lfgPosts  LfgPost[]
}

model Category {
  id        String              @id @default(cuid())
  slug      String              @unique
  name      String
  kind      ProductCategoryKind
  createdAt DateTime            @default(now())
  products  Product[]
}

model Product {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  description        String           @db.Text
  rarity             ProductRarity
  rarityRank         Int
  listingType        ListingType      @default(FIXED)
  moderationStatus   ModerationStatus @default(DRAFT)
  priceCents         Int
  currency           String           @default("USD")
  inventoryQty       Int              @default(0)
  platforms          GamePlatform[]
  sellerUserId       String
  shopId             String?
  gameId             String
  categoryId         String
  publishedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  seller    User              @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)
  shop      Shop?             @relation(fields: [shopId], references: [id], onDelete: SetNull)
  game      Game              @relation(fields: [gameId], references: [id], onDelete: Restrict)
  category  Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants  ProductVariant[]
  media     ProductMedia[]
  favorites ProductFavorite[]
  orderItems OrderItem[]
  auction    Auction?

  @@index([moderationStatus, publishedAt])
  @@index([gameId])
  @@index([categoryId])
  @@index([rarity])
  @@index([sellerUserId])
  @@index([shopId])
  @@index([priceCents])
  @@index([rarityRank])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  sku          String   @unique
  name         String
  priceCents   Int?
  inventoryQty Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductMedia {
  id        String           @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int              @default(0)
  kind      ProductMediaKind @default(IMAGE)
  createdAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductFavorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

enum ShopVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ShopMemberRole {
  OWNER
  MODERATOR
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model Shop {
  id                   String                 @id @default(cuid())
  slug                 String                 @unique
  name                 String
  bio                  String                 @db.Text
  ownerUserId          String                 @unique
  verificationStatus   ShopVerificationStatus @default(UNVERIFIED)
  verificationNote     String?
  stripeAccountId      String?                @unique
  chargesEnabled       Boolean                @default(false)
  payoutsEnabled       Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  owner    User         @relation("ShopOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members  ShopMember[]
  follows  ShopFollow[]
  reviews  ShopReview[]
  products Product[]
  orders   Order[]
}

model ShopMember {
  shopId    String
  userId    String
  role      ShopMemberRole
  createdAt DateTime       @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shopId, userId])
  @@index([userId])
}

model ShopFollow {
  shopId    String
  userId    String
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shopId, userId])
  @@index([userId])
}

model ShopReview {
  id           String   @id @default(cuid())
  shopId       String
  authorUserId String
  rating       Int
  body         String   @db.Text
  createdAt    DateTime @default(now())

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  author User @relation("ShopReviewAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([shopId, authorUserId])
  @@index([shopId])
}

enum OrderKind {
  FIXED
  AUCTION
}

model Order {
  id                      String      @id @default(cuid())
  publicRef               String      @unique
  shopId                  String
  buyerUserId             String
  status                  OrderStatus @default(PENDING)
  kind                    OrderKind   @default(FIXED)
  totalCents              Int
  applicationFeeCents     Int         @default(0)
  sellerPayoutCents       Int
  currency                String      @default("USD")
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?
  idempotencyKey          String      @unique
  auctionId               String?
  paidAt                  DateTime?
  refundedAt              DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  shop  Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  buyer User        @relation("OrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([shopId, createdAt])
  @@index([buyerUserId])
  @@index([status])
}

model ProcessedStripeEvent {
  eventId   String   @id
  type      String
  createdAt DateTime @default(now())
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  titleSnapshot  String
  quantity       Int
  unitPriceCents Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  RESERVED
  CANCELLED
}

enum BidStatus {
  ACTIVE
  OUTBID
  WON
  VOID
}

model Auction {
  id                String        @id @default(cuid())
  productId         String        @unique
  status            AuctionStatus @default(SCHEDULED)
  startingBidCents  Int
  minIncrementCents Int
  highBidCents      Int?
  bidCount          Int           @default(0)
  startsAt          DateTime
  endsAt            DateTime
  winnerUserId      String?
  reservedUntil     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  winner  User?   @relation("AuctionWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  bids    Bid[]

  @@index([status, endsAt])
  @@index([winnerUserId])
}

model Bid {
  id             String    @id @default(cuid())
  auctionId      String
  bidderUserId   String
  amountCents    Int
  status         BidStatus @default(ACTIVE)
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderUserId], references: [id], onDelete: Restrict)

  @@index([auctionId, amountCents])
  @@index([bidderUserId, createdAt])
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum GroupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Group {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  bio            String           @db.Text
  visibility     GroupVisibility  @default(PUBLIC)
  taggingAllowed Boolean          @default(true)
  ownerUserId    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  owner         User                @relation("GroupOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members       GroupMember[]
  joinRequests  GroupJoinRequest[]
  invitations   GroupInvitation[]
  bans          GroupBan[]

  @@index([visibility, createdAt])
  @@index([ownerUserId])
}

model GroupMember {
  groupId   String
  userId    String
  role      GroupMemberRole @default(MEMBER)
  createdAt DateTime        @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model GroupJoinRequest {
  id        String             @id @default(cuid())
  groupId   String
  userId    String
  status    GroupRequestStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, status])
}

model GroupInvitation {
  id            String            @id @default(cuid())
  groupId       String
  invitedUserId String
  invitedByUserId String
  status        GroupInviteStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitee   User  @relation("GroupInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("GroupInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@unique([groupId, invitedUserId])
  @@index([invitedUserId, status])
}

model GroupBan {
  groupId       String
  userId        String
  bannedByUserId String
  reason        String?
  createdAt     DateTime @default(now())

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User  @relation("GroupBanTarget", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy User  @relation("GroupBanActor", fields: [bannedByUserId], references: [id], onDelete: Restrict)

  @@id([groupId, userId])
  @@index([userId])
}

enum LfgRegion {
  NA
  EU
  SA
  AS
  OC
  AF
  ANY
}

enum LfgSkill {
  CASUAL
  INTERMEDIATE
  COMPETITIVE
  ANY
}

enum LfgMic {
  REQUIRED
  OPTIONAL
  NO_MIC
}

enum LfgStatus {
  OPEN
  FULL
  EXPIRED
  CANCELLED
}

enum LfgRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model LfgPost {
  id             String      @id @default(cuid())
  publicRef      String      @unique
  authorUserId   String
  title          String
  body           String      @db.Text
  gameId         String
  platform       GamePlatform
  region         LfgRegion
  timezone       String
  skillLevel     LfgSkill
  mic            LfgMic
  availability   String
  slotsTotal     Int
  slotsFilled    Int         @default(1)
  status         LfgStatus   @default(OPEN)
  expiresAt      DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  author   User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  game     Game         @relation(fields: [gameId], references: [id], onDelete: Restrict)
  requests LfgRequest[]

  @@index([status, expiresAt])
  @@index([gameId, createdAt])
  @@index([authorUserId])
}

model LfgRequest {
  id        String           @id @default(cuid())
  postId    String
  userId    String
  status    LfgRequestStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  post LfgPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, status])
}
