# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Serwist build output
public/sw.js
public/sw.js.map
public/swe-worker-*

# editors
.vscode/
.idea/
*.swp

# python leftovers
__pycache__/
*.pyc
.venv/
venv/

# caches
.tmp/
.cache/
.turbo/

/lib/generated/prisma

# Prisma init noise (local agent skills — not part of KOBA)
.agents/
.claude/
.windsurf/
skills-lock.json
