// KOBA — canonical schema. Populated in Phase 12 once Phases 1-11 are built
// and their per-module data models are reconciled here. See ROADMAP.md.
//
// Phase 1 note: apps/api/src/modules/kobaid currently stores KOBAIDs behind
// an in-memory KobaIdRepository (see that module's README for why), so
// nothing in apps/api talks to these models yet. They are added here now,
// ahead of Phase 12, so the shape is validated early and so a future
// Prisma-backed KobaIdRepository implementation has a target schema that
// won't need breaking changes for the KOBAID format itself.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Community roles (PL/BZ/IN) are self-registered. Staff roles (SA/AD/MD)
/// are only created via the admin-issuance path — see kobaid module README.
enum KobaIdRole {
  PL
  BZ
  IN
  SA
  AD
  MD
}

/// Auth identity, distinct from KobaId. A User has one or more KobaIds,
/// one per role per device (see KobaId's unique constraint below).
model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  devices  Device[]
  kobaIds  KobaId[]
  interests UserInterest[]
}

/// Device fingerprint/binding used to enforce "one KOBAID per role per
/// device" at issuance time.
model Device {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  kobaIds KobaId[]

  @@index([userId])
}

/// Minted KOBAID. Immutable once created — deliberately no mutable field
/// beyond referralCode set at mint time; there is no updatedAt because
/// there is no update path (corrections are a new issuance, not an edit).
///
/// TODO(TDLS): the client has since defined TDLS as ephemeral-symmetric-key
/// envelope encryption (AES-256-GCM) for the *transport* boundary between
/// sandboxed functions/services — see apps/api/src/common/tdls/README.md
/// and KobaidService#exportForTransport()/#importFromTransport(), both
/// implemented. That covers data in transit only. `code`/`fullId` are
/// still stored here as plain validated strings — at-rest (storage)
/// encryption for this model is a separate, genuinely still-open concern
/// the client hasn't spoken to. Do not invent an at-rest scheme here.
model KobaId {
  id     String     @id @default(uuid())
  role   KobaIdRole
  /// 4-char code from the ambiguity-excluded alphabet (see kobaid-format.ts).
  code   String
  /// Full rendered identifier, e.g. "KOBA-PL-7F3K".
  fullId String     @unique

  userId   String
  user     User   @relation(fields: [userId], references: [id])
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id])

  /// Pointer to Phase 10's referral/promo code system — not modeled here.
  referralCode String?

  /// For staff-issued KOBAIDs, the issuing (staff) KobaId. Null for
  /// self-registered community KOBAIDs.
  issuedByKobaId String?
  issuedBy       KobaId?  @relation("StaffIssuance", fields: [issuedByKobaId], references: [id])
  issued         KobaId[] @relation("StaffIssuance")

  mintedAt DateTime @default(now())

  /// Whether this KOBAID is the device's currently active role. Defaults
  /// to false at mint/issuance time; flipped only by account switching
  /// (Phase 2's AccountSwitchService). Switching never changes role/code/
  /// fullId/mintedAt — see the immutability note on this model above.
  active Boolean @default(false)

  cosmeticOwnerships KobaIdCosmeticOwnership[]
  staffIssuanceLogEntriesAsIssuer StaffIssuanceLog[] @relation("StaffIssuanceLogIssuer")
  staffIssuanceLogEntriesAsIssued StaffIssuanceLog[] @relation("StaffIssuanceLogIssued")

  /// Phase 3 (Marketplace Core) back-relations — additive only, added
  /// ahead of Phase 12 so the target shape is validated early, same
  /// spirit as `cosmeticOwnerships` above. `apps/api`'s marketplace
  /// module still stores everything behind in-memory repositories this
  /// phase (see apps/api/src/modules/marketplace/README.md).
  productsListed    Product[]        @relation("ProductSeller")
  bidsPlaced        Bid[]            @relation("BidBidder")
  ordersAsBuyer     Order[]          @relation("OrderBuyer")
  ordersAsSeller    Order[]          @relation("OrderSeller")
  stripeAccount     StripeAccount?

  /// Phase 4 (Shops + Business Tools) back-relations — additive only,
  /// same "validated ahead of Phase 12" posture as the Phase 3 relations
  /// above. `apps/api`'s shops module still stores everything behind
  /// in-memory repositories this phase (see
  /// apps/api/src/modules/shops/README.md).
  shopsOwned  Shop[]         @relation("ShopOwner")
  shopFollows ShopFollower[] @relation("ShopFollowerKobaId")

  /// Phase 5 (Groups + LFG) back-relations — additive only, same
  /// "validated ahead of Phase 12" posture as the Phase 3/4 relations
  /// above. `apps/api`'s groups module still stores everything behind
  /// in-memory repositories this phase (see
  /// apps/api/src/modules/groups/README.md).
  groupsOwned       Group[]           @relation("GroupOwner")
  groupMemberships  GroupMembership[] @relation("GroupMembershipMember")
  groupPosts        GroupPost[]       @relation("GroupPostAuthor")
  lfgPosts          LfgPost[]         @relation("LfgPostAuthor")

  /// One KOBAID per (deviceId, role) pair.
  @@unique([deviceId, role])
  @@index([userId])
}

/// Append-only audit trail of `KobaidService#issueStaff()` calls — the
/// `StaffIssuanceLog` concept from ROADMAP.md's Phase 1 section (issuer
/// KOBAID, issued KOBAID, target role, timestamp). Distinct from
/// `KobaId.issuedByKobaId`, which is the minimum pointer needed for
/// tracing; this is the durable log a Phase 11 admin panel would read.
model StaffIssuanceLog {
  id String @id @default(uuid())

  issuerKobaId String
  issuer       KobaId @relation("StaffIssuanceLogIssuer", fields: [issuerKobaId], references: [id])

  issuedKobaId String
  issued       KobaId @relation("StaffIssuanceLogIssued", fields: [issuedKobaId], references: [id])

  targetRole KobaIdRole
  issuedAt   DateTime   @default(now())

  @@index([issuerKobaId])
}

/// Placeholder relation to owned cosmetics. Cosmetics themselves are
/// Phase 3 (Marketplace Core) — this only models the join shape (a list of
/// cosmetic ids) so Phase 3 has somewhere to attach ownership records.
model KobaIdCosmeticOwnership {
  id         String @id @default(uuid())
  kobaIdId   String
  kobaId     KobaId @relation(fields: [kobaIdId], references: [id])
  /// Opaque reference to a Phase 3 Cosmetic id — no FK yet since that
  /// model doesn't exist in this phase.
  cosmeticId String

  @@index([kobaIdId])
}

/// Canonical interest hashtag. Catalog management is out of Phase 1 scope
/// — this only exists so UserInterest has something to join against.
model Interest {
  id   String @id @default(uuid())
  name String @unique

  users UserInterest[]
}

/// Join table enforcing (at the application layer, via InterestsValidator)
/// the "minimum 4 interests" onboarding rule.
model UserInterest {
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  interestId String
  interest   Interest @relation(fields: [interestId], references: [id])

  @@id([userId, interestId])
}

// ---------------------------------------------------------------------
// Phase 3 — Marketplace Core
//
// apps/api/src/modules/marketplace currently stores all of this behind
// in-memory repositories (ProductRepository/AuctionRepository/
// OrderRepository/StripeAccountRepository) — same storage decision as
// Phase 1's KobaIdRepository, see that module's README for the
// rationale. These models are added here now, ahead of Phase 12, so the
// target shape is validated early ("prisma validate") and a future
// Prisma-backed repository implementation won't need breaking changes.
//
// Per Phase 1's immutability note, FKs to KobaId are RESTRICT (Prisma's
// default onDelete behavior), not CASCADE.
// ---------------------------------------------------------------------

/// Six-tier rarity ladder — matches design/ui-ux-design-system.html's
/// `.rarity-chip` classes exactly. See ROADMAP.md's open question #5
/// (tier naming needs client confirmation).
enum RarityTier {
  common
  uncommon
  rare
  epic
  legendary
  relic
}

/// Listing categories. COSMETIC is the only one that pairs with a
/// CosmeticType (see below).
enum ProductCategory {
  skin
  map
  monument
  asset
  cosmetic
}

/// Cosmetics are pre-made and sold, never built by the buyer (ROADMAP.md
/// Phase 0/9) — exactly these three sub-types, no "packs" (a pack is a
/// checkout-time bundle of existing products, not a product category).
enum CosmeticType {
  avatarDecoration
  profileEffect
  nameplate
}

enum AuctionStatus {
  active
  ended
}

enum OrderSource {
  direct
  auction
}

/// Structural model of Stripe Connect account state only — matches the
/// three states shown in the Phase 0 design's Stripe Connection screen.
/// No real Stripe SDK/API integration behind this yet — see
/// apps/api/src/modules/marketplace/README.md's TODOs.
enum StripeAccountStatus {
  notConnected
  pending
  active
}

/// A marketplace listing. Immutable once created except `delisted` — a
/// soft toggle only (delist ≠ delete, keeps order history intact); there
/// is deliberately no hard-delete anywhere in this module.
model Product {
  id String @id @default(uuid())

  sellerId String
  seller   KobaId @relation("ProductSeller", fields: [sellerId], references: [id])

  title       String
  description String
  /// Small allowlist sample validated at the application layer against
  /// README.md's "Supported games" list, not a Postgres enum — see
  /// marketplace.types.ts's SUPPORTED_GAMES.
  game        String

  category ProductCategory
  rarity   RarityTier

  /// Integer cents. Never a float, anywhere in this module.
  priceCents Int

  /// Only set when category == cosmetic; enforced at the application
  /// layer (CosmeticTypeRequiredError / CosmeticTypeNotAllowedError).
  cosmeticType CosmeticType?

  delisted  Boolean  @default(false)
  createdAt DateTime @default(now())

  /// Phase 4 (Shops) — set when this product was created "through" a
  /// shop (see apps/api/src/modules/shops/shop-product.service.ts). Null
  /// for products listed directly by a KOBAID with no shop attribution.
  /// Additive-only column on this already-existing model.
  shopId String?
  shop   Shop?   @relation(fields: [shopId], references: [id])

  auctions Auction[]
  orders   Order[]

  @@index([sellerId])
  @@index([game])
  @@index([shopId])
}

/// One active auction per product at a time — enforced at the
/// application layer (ActiveAuctionExistsError), not a DB constraint,
/// since "active" is a computed/status field rather than a natural key.
model Auction {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Denormalized from Product at start time.
  sellerId String

  startPriceCents   Int
  minIncrementCents Int
  endsAt            DateTime
  status            AuctionStatus @default(active)
  createdAt         DateTime      @default(now())

  bids  Bid[]
  order Order?

  @@index([productId])
  @@index([endsAt])
}

model Bid {
  id String @id @default(uuid())

  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id])

  bidderKobaId String
  bidder       KobaId @relation("BidBidder", fields: [bidderKobaId], references: [id])

  amountCents Int
  placedAt    DateTime @default(now())

  @@index([auctionId])
}

/// A completed purchase — either a direct Buy (source == direct) or the
/// settlement of a won auction (source == auction, auctionId set).
model Order {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  buyerKobaId String
  buyer       KobaId @relation("OrderBuyer", fields: [buyerKobaId], references: [id])

  sellerKobaId String
  seller       KobaId @relation("OrderSeller", fields: [sellerKobaId], references: [id])

  amountCents Int
  createdAt   DateTime    @default(now())
  source      OrderSource

  /// Set only when source == auction — one Order per settled Auction.
  auctionId String?  @unique
  auction   Auction? @relation(fields: [auctionId], references: [id])

  @@index([buyerKobaId])
  @@index([sellerKobaId])
}

/// Per-seller-KOBAID Stripe Connect account status. Structural only —
/// no real charge creation, webhook handling, or Connect onboarding
/// wired up yet (see apps/api/src/modules/marketplace/README.md).
///
/// TODO(platform fee rate): the actual platform fee % (flat vs. tiered,
/// whether it varies by product type/rarity) is an open client question
/// (ROADMAP.md "Open questions for the client" #8) — not modeled as a
/// column here; the fee-math itself lives in application code
/// (StripeConnectService#calculateFee) with the rate injected as
/// configuration, not a schema value.
model StripeAccount {
  id String @id @default(uuid())

  kobaId String @unique
  seller KobaId @relation(fields: [kobaId], references: [id])

  status    StripeAccountStatus @default(notConnected)
  updatedAt DateTime            @updatedAt
}

// ---------------------------------------------------------------------
// Phase 4 — Shops + Business Tools
//
// apps/api/src/modules/shops currently stores all of this behind
// in-memory repositories (ShopRepository/ShopFollowerRepository) — same
// storage decision and rationale as Phase 1/3 above (see that module's
// README). These models are added here now, ahead of Phase 12, so the
// target shape is validated early ("prisma validate").
//
// Business info/identity (KYC) still lives entirely in Stripe's own
// dashboard, per ROADMAP.md Phase 4's hard constraint — no
// government-ID or business-legal-name field exists on this model, and
// none should ever be added here. Stripe Connect *status* (per-KOBAID)
// is already modeled by `StripeAccount` above; a shop's Stripe status is
// resolved by key (`Shop.ownerKobaId`), not a separate column here — see
// apps/api/src/modules/shops/shop-stripe-connect.service.ts.
// ---------------------------------------------------------------------

/// A shop profile. `ownerKobaId`/`createdAt` are immutable once created
/// (no update path for them anywhere in the shops module) — but
/// name/bio/bannerUrl/avatarUrl ARE editable, unlike KobaId's full
/// immutability. See apps/api/src/modules/shops/shop.types.ts's `Shop`
/// docstring.
model Shop {
  id String @id @default(uuid())

  /// Must be a Business-role (BZ) KOBAID — enforced at the application
  /// layer (ShopOwnerMustBeBusinessRoleError), not a DB constraint, since
  /// role validation reads the KOBAID's encoded role segment.
  ownerKobaId String
  owner       KobaId @relation("ShopOwner", fields: [ownerKobaId], references: [id])

  name      String
  bio       String  @default("")
  bannerUrl String?
  avatarUrl String?

  /// Owner-controlled shop-level tag-permission flag — Phase 6's
  /// shop-level analogue to accounts/tagging-permission.service.ts's
  /// role-level rules. No enforcement yet (Phase 6); flag + query only.
  allowTagging Boolean @default(true)

  /// Owner-controlled influencer-eligibility flag — config only, actual
  /// referral-code generation/payout execution is Phase 10.
  promoEligible Boolean @default(false)

  /// Exactly one of these two is set once the owner configures a payout
  /// rate (see shop.types.ts's `PromoPayoutConfig` discriminated union) —
  /// enforced at the application layer (InvalidPromoPayoutConfigError),
  /// not a DB constraint; Prisma has no native XOR check across nullable
  /// columns. Both null means "not yet configured".
  promoPayoutPercent    Float?
  promoPayoutFixedCents Int?

  createdAt DateTime @default(now())

  products  Product[]
  followers ShopFollower[]

  @@index([ownerKobaId])
}

/// Shop-follow relationship. A KOBAID can follow a shop once — the
/// composite primary key below is what makes `follow()` idempotent at
/// the storage layer (a second follow() is just an upsert onto the same
/// row, never a second record).
model ShopFollower {
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  followerKobaId String
  follower       KobaId @relation("ShopFollowerKobaId", fields: [followerKobaId], references: [id])

  followedAt DateTime @default(now())

  @@id([shopId, followerKobaId])
  @@index([followerKobaId])
}

// ---------------------------------------------------------------------
// Phase 5 — Groups + LFG
//
// apps/api/src/modules/groups currently stores all of this behind
// in-memory repositories (GroupRepository/GroupMembershipRepository/
// GroupPostRepository/LfgPostRepository) — same storage decision and
// rationale as Phases 1/3/4 above (see that module's README). These
// models are added here now, ahead of Phase 12, so the target shape is
// validated early ("prisma validate").
//
// `CommunityRole` here is deliberately a *separate* enum from
// `KobaIdRole` — ROADMAP.md's Phase 5/11 sections call out the
// community-role vs. platform-staff-role distinction as a hard
// requirement, matching apps/api/src/modules/accounts/community-role.types.ts.
// ---------------------------------------------------------------------

/// Community-level role attached to a normal Player/Business KOBAID within
/// a Group — distinct from `KobaIdRole`'s staff roles (SA/AD/MD). Matches
/// apps/api/src/modules/accounts/community-role.types.ts's `CommunityRole`
/// exactly.
enum CommunityRole {
  owner
  admin
  moderator
  member
}

/// Matches apps/api/src/modules/groups/group.types.ts's `GroupVisibility`.
enum GroupVisibility {
  public
  private
}

/// A Group. `ownerKobaId`/`createdAt` are immutable once created (no
/// update path for them anywhere in the groups module) — see
/// apps/api/src/modules/groups/group.types.ts's `Group` docstring.
model Group {
  id String @id @default(uuid())

  name       String
  visibility GroupVisibility @default(public)

  /// Immutable once set. Not restricted to a particular KobaIdRole (unlike
  /// Shop.ownerKobaId's Business-only rule) — any Player/Business KOBAID
  /// may own a Group.
  ownerKobaId String
  owner       KobaId @relation("GroupOwner", fields: [ownerKobaId], references: [id])

  /// Owner/admin-controlled group-level tag-permission flag — same shape
  /// as Shop.allowTagging. No enforcement yet (Phase 6); flag + query
  /// only.
  allowTagging Boolean @default(true)

  createdAt DateTime @default(now())

  memberships GroupMembership[]
  posts       GroupPost[]
  lfgPosts    LfgPost[]

  @@index([ownerKobaId])
}

/// Join row between a Group and a member KOBAID, carrying that member's
/// CommunityRole within the group. The group owner is auto-assigned
/// `owner` here at group-creation time (GroupService#createGroup()).
model GroupMembership {
  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  memberKobaId String
  member       KobaId @relation("GroupMembershipMember", fields: [memberKobaId], references: [id])

  role     CommunityRole @default(member)
  joinedAt DateTime      @default(now())

  @@id([groupId, memberKobaId])
  @@index([memberKobaId])
}

/// A lightweight text post scoped to a Group's feed — NOT Phase 6's full
/// social layer (no likes/comments/shares/tagging enforcement), just
/// enough of a "group feed" concept to exist and be queryable. See
/// apps/api/src/modules/groups/group-feed.service.ts.
model GroupPost {
  id String @id @default(uuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  authorKobaId String
  author       KobaId @relation("GroupPostAuthor", fields: [authorKobaId], references: [id])

  text String

  createdAt DateTime @default(now())

  @@index([groupId])
}

/// A Looking-For-Group post. `groupId` is nullable — an LFG post can be
/// independent of any Group, per the Phase 0 design's standalone LFG
/// Page. `expiresAt`/`filledSlots` are read against the clock at query
/// time (LfgService#isExpired()) — there is deliberately no separate
/// mutable `status` column that could drift from the clock, same posture
/// as Auction.endsAt above.
model LfgPost {
  id String @id @default(uuid())

  authorKobaId String
  author       KobaId @relation("LfgPostAuthor", fields: [authorKobaId], references: [id])

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  game             String
  mode             String
  requirementsText String @default("")

  maxSlots    Int
  filledSlots Int @default(0)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([authorKobaId])
  @@index([expiresAt])
}
